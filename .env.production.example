# Copy to .env.production on the server, chmod 600, and replace placeholders.
# Values remain server-local. URL-encode special characters in DATABASE_URL.
COMPOSE_PROJECT_NAME=robodovod-prod
ACME_EMAIL=<certificate-notification-email>
POSTGRES_DB=robodovod
POSTGRES_ADMIN_USER=<random-bootstrap-superuser>
POSTGRES_ADMIN_PASSWORD=<random-32+-character-password>
APP_DB_USER=robodovod_app
APP_DB_PASSWORD=<random-32+-character-password>
DATABASE_URL=postgresql+psycopg://robodovod_app:<url-encoded-password>@db:5432/robodovod

BOOTSTRAP_ADMIN_EMAIL=<owner-email>
BOOTSTRAP_ADMIN_PASSWORD=<random-20+-character-password>
BOOTSTRAP_ADMIN_NAME=<owner-name>

SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200
APP_ALLOWED_ORIGINS=https://robodovod.ru,https://www.robodovod.ru
DELETION_TOMBSTONE_DAYS=30

# Optional offline-by-default integration. Leave empty unless explicitly enabled.
YC_FOLDER_ID=
YC_API_KEY=

# Server-local restricted source directory used only by catalog media tools.
OFFICIAL_CATALOG_SOURCE_DIR=/opt/robodovod-private/catalog-source
