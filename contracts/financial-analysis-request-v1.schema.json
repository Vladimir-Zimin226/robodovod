{
  "$defs": {
    "AllocationResultV1": {
      "additionalProperties": false,
      "properties": {
        "allocated_people": {
          "minimum": 0,
          "title": "Allocated People",
          "type": "integer"
        },
        "method": {
          "enum": [
            "EXPLICIT_LARGEST_REMAINDER",
            "PERSON_SHIFTS_LARGEST_REMAINDER"
          ],
          "title": "Method",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Process Id",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "role_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Role Id",
          "type": "string"
        },
        "weight": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "role_id",
        "process_id",
        "allocated_people",
        "method",
        "weight",
        "provenance_ref"
      ],
      "title": "AllocationResultV1",
      "type": "object"
    },
    "AnnualCostLedgerV1": {
      "additionalProperties": false,
      "properties": {
        "deployment_share": {
          "const": "1",
          "default": "1",
          "title": "Deployment Share",
          "type": "string"
        },
        "operating_lines": {
          "items": {
            "$ref": "#/$defs/CostLineV1"
          },
          "title": "Operating Lines",
          "type": "array"
        },
        "operating_total": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operating Total"
        },
        "ramp": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Ramp",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ],
          "title": "Status",
          "type": "string"
        },
        "year": {
          "maximum": 15,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "ramp",
        "operating_lines",
        "operating_total",
        "status"
      ],
      "title": "AnnualCostLedgerV1",
      "type": "object"
    },
    "AnnualRoleStaffingV1": {
      "additionalProperties": false,
      "properties": {
        "ramp": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Ramp",
          "type": "string"
        },
        "released": {
          "minimum": 0,
          "title": "Released",
          "type": "integer"
        },
        "remaining": {
          "minimum": 0,
          "title": "Remaining",
          "type": "integer"
        },
        "year": {
          "maximum": 5,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "ramp",
        "released",
        "remaining"
      ],
      "title": "AnnualRoleStaffingV1",
      "type": "object"
    },
    "BaselineEquipmentV1": {
      "additionalProperties": false,
      "properties": {
        "annual_cost_per_unit": {
          "$ref": "#/$defs/SourcedValueV1"
        },
        "base_count": {
          "minimum": 0,
          "title": "Base Count",
          "type": "integer"
        },
        "withdrawn_final": {
          "minimum": 0,
          "title": "Withdrawn Final",
          "type": "integer"
        }
      },
      "required": [
        "base_count",
        "withdrawn_final",
        "annual_cost_per_unit"
      ],
      "title": "BaselineEquipmentV1",
      "type": "object"
    },
    "BatteryEventV1": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        },
        "cumulative_cycles": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Cumulative Cycles",
          "type": "string"
        },
        "events_per_robot": {
          "minimum": 0,
          "title": "Events Per Robot",
          "type": "integer"
        },
        "year": {
          "maximum": 15,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "events_per_robot",
        "cumulative_cycles",
        "amount"
      ],
      "title": "BatteryEventV1",
      "type": "object"
    },
    "CostLineV1": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "formula_id": {
          "enum": [
            "F16",
            "F17",
            "F18",
            "F19",
            "F20",
            "F21",
            "F22"
          ],
          "title": "Formula Id",
          "type": "string"
        },
        "line_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Line Id",
          "type": "string"
        },
        "ownership": {
          "enum": [
            "CUSTOMER",
            "VENDOR",
            "INTEGRATOR",
            "SHARED",
            "UNKNOWN"
          ],
          "title": "Ownership",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "source_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "EXCLUDED",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "timing": {
          "enum": [
            "CAPITAL_ONCE",
            "ANNUAL",
            "TERMINAL"
          ],
          "title": "Timing",
          "type": "string"
        },
        "unit": {
          "const": "RUB",
          "default": "RUB",
          "title": "Unit",
          "type": "string"
        },
        "year": {
          "maximum": 15,
          "minimum": 0,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "line_id",
        "formula_id",
        "category",
        "timing",
        "year",
        "status",
        "amount",
        "basis",
        "ownership"
      ],
      "title": "CostLineV1",
      "type": "object"
    },
    "ExcludedAdditionalIncomeV1": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "EXCLUDED",
          "default": "EXCLUDED",
          "title": "Mode",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        }
      },
      "required": [
        "provenance_ref"
      ],
      "title": "ExcludedAdditionalIncomeV1",
      "type": "object"
    },
    "ForkliftLedgerV1": {
      "additionalProperties": false,
      "properties": {
        "base_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Count"
        },
        "remaining": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remaining"
        },
        "source": {
          "enum": [
            "USER",
            "ROLE_DERIVED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "withdrawn": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Withdrawn"
        }
      },
      "required": [
        "status",
        "base_count",
        "withdrawn",
        "remaining",
        "source"
      ],
      "title": "ForkliftLedgerV1",
      "type": "object"
    },
    "IncludedAdditionalIncomeV1": {
      "additionalProperties": false,
      "properties": {
        "annual_amount": {
          "$ref": "#/$defs/SourcedValueV1"
        },
        "mode": {
          "const": "INCLUDED",
          "default": "INCLUDED",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "annual_amount"
      ],
      "title": "IncludedAdditionalIncomeV1",
      "type": "object"
    },
    "LabourReplayV1": {
      "additionalProperties": false,
      "properties": {
        "canonical_input_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Canonical Input Digest",
          "type": "string"
        },
        "capacity_result_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Capacity Result Digests",
          "type": "array"
        },
        "trace_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Trace Content Digest",
          "type": "string"
        }
      },
      "required": [
        "canonical_input_digest",
        "capacity_result_digests",
        "trace_content_digest"
      ],
      "title": "LabourReplayV1",
      "type": "object"
    },
    "LabourResultV1": {
      "additionalProperties": false,
      "properties": {
        "allocations": {
          "items": {
            "$ref": "#/$defs/AllocationResultV1"
          },
          "title": "Allocations",
          "type": "array"
        },
        "finance_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "NOT_APPLICABLE"
          ],
          "title": "Finance Status",
          "type": "string"
        },
        "forklifts": {
          "$ref": "#/$defs/ForkliftLedgerV1"
        },
        "input_revision": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Input Revision",
          "type": "string"
        },
        "issues": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "labour_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "NOT_APPLICABLE"
          ],
          "title": "Labour Status",
          "type": "string"
        },
        "object_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Object Id",
          "type": "string"
        },
        "object_kind": {
          "$ref": "#/$defs/ObjectKind"
        },
        "operating_staff": {
          "$ref": "#/$defs/SiteOperatingStaffV1"
        },
        "processes": {
          "items": {
            "$ref": "#/$defs/ProcessLabourResultV1"
          },
          "title": "Processes",
          "type": "array"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Project Id",
          "type": "string"
        },
        "replay": {
          "$ref": "#/$defs/LabourReplayV1"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleLabourResultV1"
          },
          "title": "Roles",
          "type": "array"
        },
        "run_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "role-labour-result-v1",
          "default": "role-labour-result-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "total_additional_control": {
          "minimum": 0,
          "title": "Total Additional Control",
          "type": "integer"
        },
        "total_deficit": {
          "minimum": 0,
          "title": "Total Deficit",
          "type": "integer"
        },
        "total_released": {
          "minimum": 0,
          "title": "Total Released",
          "type": "integer"
        },
        "total_surplus": {
          "minimum": 0,
          "title": "Total Surplus",
          "type": "integer"
        },
        "total_transferred": {
          "minimum": 0,
          "title": "Total Transferred",
          "type": "integer"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/LabourTraceNodeV1"
          },
          "title": "Trace",
          "type": "array"
        },
        "versions": {
          "$ref": "#/$defs/LabourVersionBindingsV1"
        }
      },
      "required": [
        "run_id",
        "project_id",
        "tenant_id",
        "input_revision",
        "object_id",
        "object_kind",
        "labour_status",
        "finance_status",
        "processes",
        "roles",
        "allocations",
        "operating_staff",
        "forklifts",
        "total_deficit",
        "total_surplus",
        "total_released",
        "total_transferred",
        "total_additional_control",
        "trace",
        "issues",
        "versions",
        "replay"
      ],
      "title": "LabourResultV1",
      "type": "object"
    },
    "LabourTraceNodeV1": {
      "additionalProperties": false,
      "properties": {
        "formula_id": {
          "enum": [
            "F08",
            "F09",
            "F10",
            "F11",
            "F12",
            "F13",
            "F14",
            "F15"
          ],
          "title": "Formula Id",
          "type": "string"
        },
        "formula_version": {
          "const": "calculation-formulas-v1",
          "default": "calculation-formulas-v1",
          "title": "Formula Version",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "node_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "output_name": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        },
        "output_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Value"
        },
        "provenance_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Provenance Refs",
          "type": "array"
        },
        "rounding": {
          "default": "NONE",
          "enum": [
            "NONE",
            "FLOOR",
            "CEIL"
          ],
          "title": "Rounding",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "enum": [
              "R03",
              "POLICY_V1",
              "POLICY_V2A"
            ],
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "formula_id",
        "source_refs",
        "input_refs",
        "output_name",
        "output_value",
        "unit"
      ],
      "title": "LabourTraceNodeV1",
      "type": "object"
    },
    "LabourVersionBindingsV1": {
      "additionalProperties": false,
      "properties": {
        "calculation_policy_version": {
          "const": "hackathon-calculation-policy-v1",
          "default": "hackathon-calculation-policy-v1",
          "title": "Calculation Policy Version",
          "type": "string"
        },
        "capacity_projection_version": {
          "const": "capacity-labour-projection-v1",
          "default": "capacity-labour-projection-v1",
          "title": "Capacity Projection Version",
          "type": "string"
        },
        "engine_version": {
          "const": "role-labour-baseline-v1",
          "default": "role-labour-baseline-v1",
          "title": "Engine Version",
          "type": "string"
        },
        "intake_version": {
          "const": "calculation-intake-normalization-v2",
          "default": "calculation-intake-normalization-v2",
          "title": "Intake Version",
          "type": "string"
        },
        "precision_policy_version": {
          "const": "decimal-context-28-half-even-v1",
          "default": "decimal-context-28-half-even-v1",
          "title": "Precision Policy Version",
          "type": "string"
        },
        "process_catalog_version": {
          "const": "calculation-process-catalog-v1",
          "default": "calculation-process-catalog-v1",
          "title": "Process Catalog Version",
          "type": "string"
        },
        "registry_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Registry Digest",
          "type": "string"
        },
        "registry_version": {
          "const": "hackathon-calculation-parameter-registry-v1",
          "title": "Registry Version",
          "type": "string"
        },
        "schema_version": {
          "const": "role-labour-result-v1",
          "default": "role-labour-result-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "v2a_policy_overlay_version": {
          "const": "hackathon-calculation-policy-v1+v2a-c14",
          "default": "hackathon-calculation-policy-v1+v2a-c14",
          "title": "V2A Policy Overlay Version",
          "type": "string"
        }
      },
      "required": [
        "registry_version",
        "registry_digest"
      ],
      "title": "LabourVersionBindingsV1",
      "type": "object"
    },
    "MoneyBreakdownV1": {
      "additionalProperties": false,
      "properties": {
        "annual_direct": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Annual Direct",
          "type": "string"
        },
        "annual_fixed_overhead": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Annual Fixed Overhead",
          "type": "string"
        },
        "annual_full": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Annual Full",
          "type": "string"
        },
        "annual_gross": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Annual Gross",
          "type": "string"
        },
        "monthly_gross": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Monthly Gross",
          "type": "string"
        },
        "salary_provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Salary Provenance Ref",
          "type": "string"
        },
        "unit": {
          "const": "RUB/person/year",
          "default": "RUB/person/year",
          "title": "Unit",
          "type": "string"
        },
        "zero_cost_role": {
          "title": "Zero Cost Role",
          "type": "boolean"
        }
      },
      "required": [
        "monthly_gross",
        "annual_gross",
        "annual_direct",
        "annual_full",
        "annual_fixed_overhead",
        "salary_provenance_ref",
        "zero_cost_role"
      ],
      "title": "MoneyBreakdownV1",
      "type": "object"
    },
    "ObjectKind": {
      "enum": [
        "WAREHOUSE",
        "AIRPORT",
        "CLINIC"
      ],
      "title": "ObjectKind",
      "type": "string"
    },
    "ProcessLabourResultV1": {
      "additionalProperties": false,
      "properties": {
        "allocated_people": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allocated People"
        },
        "applied": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applied"
        },
        "capacity_coverage": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Coverage"
        },
        "deficit_growth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deficit Growth"
        },
        "manual_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Unit"
