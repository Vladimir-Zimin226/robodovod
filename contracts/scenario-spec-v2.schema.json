{
  "$defs": {
    "QuantityKind": {
      "enum": [
        "TIME",
        "DISTANCE",
        "MASS",
        "AREA",
        "COUNT",
        "FLOW",
        "SPEED",
        "RATE",
        "FRACTION",
        "MONEY",
        "ENERGY",
        "POWER",
        "UNIT_DEFINITION"
      ],
      "title": "QuantityKind",
      "type": "string"
    },
    "ResultQuantity": {
      "additionalProperties": false,
      "properties": {
        "numeric_encoding": {
          "const": "DECIMAL_STRING",
          "default": "DECIMAL_STRING",
          "title": "Numeric Encoding",
          "type": "string"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "quantity_kind"
      ],
      "title": "ResultQuantity",
      "type": "object"
    },
    "ScenarioAnalysisBindingV2": {
      "additionalProperties": false,
      "properties": {
        "capacity_request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Capacity Request Digest",
          "type": "string"
        },
        "capacity_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Capacity Result Digest",
          "type": "string"
        },
        "capacity_run_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Capacity Run Id",
          "type": "string"
        },
        "capacity_trace_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Capacity Trace Digest",
          "type": "string"
        },
        "input_revision": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Input Revision",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Project Id",
          "type": "string"
        },
        "tenant_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "tenant_id",
        "capacity_run_id",
        "input_revision",
        "capacity_request_digest",
        "capacity_result_digest",
        "capacity_trace_digest"
      ],
      "title": "ScenarioAnalysisBindingV2",
      "type": "object"
    },
    "ScenarioAssumptionV2": {
      "additionalProperties": false,
      "properties": {
        "assumption_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Assumption Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "assumption_id",
        "version",
        "provenance_ref",
        "scope",
        "message"
      ],
      "title": "ScenarioAssumptionV2",
      "type": "object"
    },
    "ScenarioBatchV2": {
      "additionalProperties": false,
      "properties": {
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "semantics": {
          "enum": [
            "PHYSICAL_BATCH",
            "AREA_MICROTASK",
            "ONE_OUTPUT_UNIT"
          ],
          "title": "Semantics",
          "type": "string"
        },
        "units_per_cycle": {
          "$ref": "#/$defs/ResultQuantity"
        }
      },
      "required": [
        "semantics",
        "units_per_cycle",
        "provenance_ref"
      ],
      "title": "ScenarioBatchV2",
      "type": "object"
    },
    "ScenarioExchangeV2": {
      "additionalProperties": false,
      "properties": {
        "load_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "enum": [
            "TOTAL",
            "SPLIT",
            "NOT_APPLICABLE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "total_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unload_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultQuantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode"
      ],
      "title": "ScenarioExchangeV2",
      "type": "object"
    },
    "ScenarioFinanceBindingV2": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "enum": [
            "PURCHASE",
            "RAAS"
          ],
          "title": "Acquisition",
          "type": "string"
        },
        "cohort_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Cohort Id",
          "type": "string"
        },
        "horizon_years": {
          "maximum": 15,
          "minimum": 5,
          "title": "Horizon Years",
          "type": "integer"
        },
        "npv_project": {
          "$ref": "#/$defs/ScenarioFinanceMetricV2"
        },
        "project_capex_cashflow": {
          "$ref": "#/$defs/ScenarioFinanceMetricV2"
        },
        "simple_payback": {
          "$ref": "#/$defs/ScenarioFinanceMetricV2"
        },
        "source_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Result Digest",
          "type": "string"
        },
        "source_run_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Source Run Id",
          "type": "string"
        },
        "source_schema_version": {
          "const": "multiprocess-allocation-result-v1",
          "title": "Source Schema Version",
          "type": "string"
        },
        "uncertainty": {
          "enum": [
            "PESSIMISTIC",
            "BASE",
            "OPTIMISTIC"
          ],
          "title": "Uncertainty",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/ScenarioFinanceVersionsV2"
        }
      },
      "required": [
        "source_schema_version",
        "source_run_id",
        "source_result_digest",
        "cohort_id",
        "acquisition",
        "uncertainty",
        "horizon_years",
        "project_capex_cashflow",
        "npv_project",
        "simple_payback",
        "versions"
      ],
      "title": "ScenarioFinanceBindingV2",
      "type": "object"
    },
    "ScenarioFinanceMetricV2": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "NOT_REACHED"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "RUB",
            "YEAR"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "status",
        "value",
        "unit"
      ],
      "title": "ScenarioFinanceMetricV2",
      "type": "object"
    },
    "ScenarioFinanceVersionsV2": {
      "additionalProperties": false,
      "properties": {
        "calculation_policy_version": {
          "const": "hackathon-calculation-policy-v1",
          "title": "Calculation Policy Version",
          "type": "string"
        },
        "engine_version": {
          "const": "multiprocess-allocation-v1",
          "title": "Engine Version",
          "type": "string"
        },
        "labour_policy_overlay_version": {
          "const": "hackathon-calculation-policy-v1+v2a-c14",
          "title": "Labour Policy Overlay Version",
          "type": "string"
        },
        "precision_policy_version": {
          "const": "decimal-context-28-half-even-v1",
          "title": "Precision Policy Version",
          "type": "string"
        },
        "registry_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Registry Digest",
          "type": "string"
        },
        "registry_version": {
          "const": "hackathon-calculation-parameter-registry-v1",
          "title": "Registry Version",
          "type": "string"
        },
        "result_version": {
          "const": "multiprocess-allocation-result-v1",
          "title": "Result Version",
          "type": "string"
        }
      },
      "required": [
        "engine_version",
        "result_version",
        "calculation_policy_version",
        "labour_policy_overlay_version",
        "registry_version",
        "registry_digest",
        "precision_policy_version"
      ],
      "title": "ScenarioFinanceVersionsV2",
      "type": "object"
    },
    "ScenarioFleetBindingV2": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
