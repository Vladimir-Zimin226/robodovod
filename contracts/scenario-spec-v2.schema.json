          "$ref": "#/$defs/ResultQuantity"
        },
        "exchange": {
          "$ref": "#/$defs/ScenarioExchangeV2"
        },
        "operating_window_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
