        "start_time": {
          "$ref": "#/$defs/ResultQuantity"
        },
        "timezone": {
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "window_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "window_id",
        "start_time",
        "duration",
        "timezone",
        "source",
        "provenance_ref"
      ],
      "title": "ScenarioOperatingWindowV2",
      "type": "object"
    },
    "ScenarioProfileV2": {
      "additionalProperties": false,
