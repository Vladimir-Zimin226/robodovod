        },
        "effective_capacity": {
          "$ref": "#/$defs/ResultQuantity"
        },
        "fleet_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Fleet Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "nominal_capacity": {
          "$ref": "#/$defs/ResultQuantity"
        },
        "overloaded": {
          "title": "Overloaded",
          "type": "boolean"
        },
        "position_id": {
          "minLength": 1,
          "title": "Position Id",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Process Id",
          "type": "string"
        },
        "raw_load_ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_fleet": {
          "minimum": 0,
          "title": "Recommended Fleet",
          "type": "integer"
        },
        "selected_fleet": {
          "minimum": 0,
          "title": "Selected Fleet",
          "type": "integer"
        },
        "utilization": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "zone_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Zone Id",
          "type": "string"
        }
      },
      "required": [
        "fleet_id",
        "zone_id",
        "process_id",
        "model_id",
        "position_id",
        "selected_fleet",
        "recommended_fleet",
        "nominal_capacity",
        "effective_capacity",
        "coverage",
        "raw_load_ratio",
        "utilization",
        "overloaded"
      ],
      "title": "ScenarioFleetBindingV2",
      "type": "object"
    },
    "ScenarioOperatingWindowV2": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "$ref": "#/$defs/ResultQuantity"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
