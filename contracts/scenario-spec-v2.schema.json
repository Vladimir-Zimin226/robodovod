      "required": [
        "process_id",
        "process_code",
        "process_scope",
        "calculation_profile",
        "quantity_kind",
        "capacity_status"
      ],
      "title": "ScenarioProfileV2",
      "type": "object"
    },
    "ScenarioRouteBindingV2": {
      "additionalProperties": false,
