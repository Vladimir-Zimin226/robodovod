{
  "$defs": {
    "AllocationResultV1": {
      "additionalProperties": false,
      "properties": {
        "allocated_people": {
          "minimum": 0,
          "title": "Allocated People",
          "type": "integer"
        },
        "method": {
          "enum": [
            "EXPLICIT_LARGEST_REMAINDER",
            "PERSON_SHIFTS_LARGEST_REMAINDER"
          ],
          "title": "Method",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Process Id",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "role_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Role Id",
          "type": "string"
        },
        "weight": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "role_id",
        "process_id",
        "allocated_people",
        "method",
        "weight",
        "provenance_ref"
      ],
      "title": "AllocationResultV1",
      "type": "object"
    },
    "AnnualRoleStaffingV1": {
