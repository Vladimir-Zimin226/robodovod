          "minimum": 0,
          "title": "Released",
          "type": "integer"
        },
        "remaining": {
          "minimum": 0,
          "title": "Remaining",
          "type": "integer"
        },
        "year": {
          "maximum": 5,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "ramp",
        "released",
        "remaining"
      ],
      "title": "AnnualRoleStaffingV1",
      "type": "object"
    },
