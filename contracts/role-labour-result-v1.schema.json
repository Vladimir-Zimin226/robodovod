    "LabourTraceNodeV1": {
      "additionalProperties": false,
      "properties": {
        "formula_id": {
          "enum": [
            "F08",
            "F09",
            "F10",
            "F11",
            "F12",
            "F13",
            "F14",
            "F15"
          ],
          "title": "Formula Id",
          "type": "string"
        },
        "formula_version": {
          "const": "calculation-formulas-v1",
          "default": "calculation-formulas-v1",
          "title": "Formula Version",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "node_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "output_name": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        },
        "output_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Value"
        },
        "provenance_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Provenance Refs",
          "type": "array"
        },
        "rounding": {
          "default": "NONE",
          "enum": [
            "NONE",
            "FLOOR",
            "CEIL"
          ],
          "title": "Rounding",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "enum": [
              "R03",
              "POLICY_V1",
              "POLICY_V2A"
            ],
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "formula_id",
        "source_refs",
        "input_refs",
        "output_name",
        "output_value",
        "unit"
      ],
      "title": "LabourTraceNodeV1",
      "type": "object"
    },
    "LabourVersionBindingsV1": {
      "additionalProperties": false,
      "properties": {
        "calculation_policy_version": {
          "const": "hackathon-calculation-policy-v1",
          "default": "hackathon-calculation-policy-v1",
          "title": "Calculation Policy Version",
          "type": "string"
        },
        "capacity_projection_version": {
          "const": "capacity-labour-projection-v1",
          "default": "capacity-labour-projection-v1",
          "title": "Capacity Projection Version",
          "type": "string"
        },
        "engine_version": {
          "const": "role-labour-baseline-v1",
          "default": "role-labour-baseline-v1",
