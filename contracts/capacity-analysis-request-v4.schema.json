{
  "$defs": {
    "AssumptionProvenance": {
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        },
        "kind": {
          "const": "ASSUMPTION",
          "default": "ASSUMPTION",
          "title": "Kind",
          "type": "string"
        },
        "assumption_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Assumption Id",
          "type": "string"
        },
        "assumption_version": {
          "minLength": 1,
          "title": "Assumption Version",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "permitted_scope": {
          "minLength": 1,
          "title": "Permitted Scope",
          "type": "string"
        },
        "confirmation_state": {
          "enum": [
            "POLICY_ACCEPTED",
            "USER_CONFIRMED"
          ],
          "title": "Confirmation State",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "assumption_id",
        "assumption_version",
        "rationale",
        "permitted_scope",
        "confirmation_state"
      ],
      "title": "AssumptionProvenance",
      "type": "object"
    },
    "CapacityZoneContextV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "capacity-zone-context-v1",
          "default": "capacity-zone-context-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "zone_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Zone Id",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "constraints_note": {
          "default": "",
          "maxLength": 1000,
          "title": "Constraints Note",
          "type": "string"
        },
        "constraints_status": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Constraints Status",
          "type": "string"
        }
      },
      "required": [
        "zone_id",
        "label"
      ],
      "title": "CapacityZoneContextV1",
      "type": "object"
    },
    "DerivedProvenance": {
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        },
        "kind": {
          "const": "DERIVED",
          "default": "DERIVED",
          "title": "Kind",
          "type": "string"
        },
        "parent_node_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Parent Node Ids",
          "type": "array"
        }
      },
      "required": [
        "provenance_id",
        "parent_node_ids"
      ],
      "title": "DerivedProvenance",
      "type": "object"
    },
    "FacilityAreaValueV1": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "const": "m2",
          "default": "m2",
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "enum": [
            "USER",
            "FILE",
            "ASSUMPTION",
            "LLM"
          ],
          "title": "Source",
          "type": "string"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "source",
        "confirmed"
      ],
      "title": "FacilityAreaValueV1",
      "type": "object"
    },
    "FacilityContextV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "facility-context-v1",
          "default": "facility-context-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "total_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/FacilityAreaValueV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "active_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/FacilityAreaValueV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "FacilityContextV1",
      "type": "object"
    },
    "FileProvenance": {
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        },
        "kind": {
          "const": "FILE",
          "default": "FILE",
          "title": "Kind",
          "type": "string"
        },
        "file_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "File Digest",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "file_digest",
        "locator"
      ],
      "title": "FileProvenance",
      "type": "object"
    },
    "KnownQuantity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "KNOWN",
          "default": "KNOWN",
          "title": "Status",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/QuantityName"
        },
        "raw_value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Raw Value",
          "type": "string"
        },
        "raw_unit": {
          "$ref": "#/$defs/Unit"
        },
        "normalized_value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Normalized Value",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "numeric_encoding": {
          "const": "DECIMAL_STRING",
          "default": "DECIMAL_STRING",
          "title": "Numeric Encoding",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        }
      },
      "required": [
        "name",
        "raw_value",
        "raw_unit",
        "normalized_value",
        "unit",
        "quantity_kind",
        "provenance_ref"
      ],
      "title": "KnownQuantity",
      "type": "object"
    },
    "MissingQuantity": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "MISSING",
          "default": "MISSING",
          "title": "Status",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/QuantityName"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "expected_unit": {
          "$ref": "#/$defs/Unit"
        },
        "missing_reason": {
          "$ref": "#/$defs/MissingReason"
        },
        "provenance_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Ref"
        }
      },
      "required": [
        "name",
        "quantity_kind",
        "expected_unit",
        "missing_reason"
      ],
      "title": "MissingQuantity",
      "type": "object"
    },
    "MissingReason": {
      "enum": [
        "MISSING_INPUT",
        "MISSING_SAFE_FACT",
        "UNIT_MISMATCH",
        "CONFLICTING_FACT",
        "UNAPPROVED_ASSUMPTION",
        "NOT_APPLICABLE"
      ],
      "title": "MissingReason",
      "type": "string"
    },
    "NormalizedProcess": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "normalized-process-v1",
          "default": "normalized-process-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Process Id",
          "type": "string"
        },
        "input_revision": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Input Revision",
          "type": "string"
        },
        "object_kind": {
          "$ref": "#/$defs/ObjectKind"
        },
        "process_code": {
          "$ref": "#/$defs/ProcessCode"
        },
        "scope": {
          "$ref": "#/$defs/ProcessScope"
        },
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "quantity_kind": {
          "$ref": "#/$defs/ProcessQuantityKind"
        },
        "demand": {
          "discriminator": {
            "mapping": {
              "KNOWN": "#/$defs/KnownQuantity",
              "MISSING": "#/$defs/MissingQuantity"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/KnownQuantity"
            },
            {
              "$ref": "#/$defs/MissingQuantity"
            }
          ],
          "title": "Demand"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessSchedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route_distance": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "KNOWN": "#/$defs/KnownQuantity",
                  "MISSING": "#/$defs/MissingQuantity"
                },
                "propertyName": "status"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/KnownQuantity"
                },
                {
                  "$ref": "#/$defs/MissingQuantity"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Distance"
        },
        "exchange": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "SPLIT": "#/$defs/SplitExchange",
                  "TOTAL": "#/$defs/TotalExchange"
                },
                "propertyName": "mode"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TotalExchange"
                },
                {
                  "$ref": "#/$defs/SplitExchange"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "item_mass": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "KNOWN": "#/$defs/KnownQuantity",
                  "MISSING": "#/$defs/MissingQuantity"
                },
                "propertyName": "status"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/KnownQuantity"
                },
                {
                  "$ref": "#/$defs/MissingQuantity"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Mass"
        },
        "explicit_batch": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "KNOWN": "#/$defs/KnownQuantity",
                  "MISSING": "#/$defs/MissingQuantity"
                },
                "propertyName": "status"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/KnownQuantity"
                },
                {
                  "$ref": "#/$defs/MissingQuantity"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explicit Batch"
        },
        "role_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Role Refs",
          "type": "array"
        }
      },
      "required": [
        "process_id",
        "input_revision",
        "object_kind",
        "process_code",
        "scope",
        "active",
        "quantity_kind",
        "demand"
      ],
      "title": "NormalizedProcess",
      "type": "object"
    },
    "ObjectKind": {
      "enum": [
        "WAREHOUSE",
        "AIRPORT",
        "CLINIC"
      ],
      "title": "ObjectKind",
      "type": "string"
    },
    "OperatingAvailabilityV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "operating-availability-v1",
          "default": "operating-availability-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "mode": {
          "enum": [
            "ALL_IN",
            "EXPLICIT_DOWNTIME"
          ],
          "title": "Mode",
          "type": "string"
        },
        "availability": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability"
        },
        "autonomy_hours": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autonomy Hours"
        },
        "charge_hours": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Charge Hours"
        },
        "service_hours_per_day": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Hours Per Day"
        },
        "refill_hours_per_day": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refill Hours Per Day"
        },
        "basis": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Basis",
          "type": "string"
        },
        "source": {
          "enum": [
            "USER",
            "ASSUMPTION"
          ],
          "title": "Source",
          "type": "string"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "basis",
        "source",
        "confirmed"
      ],
      "title": "OperatingAvailabilityV1",
      "type": "object"
    },
    "PolicyProvenance": {
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        },
        "kind": {
          "const": "POLICY",
          "default": "POLICY",
          "title": "Kind",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "decision_refs": {
          "items": {
            "pattern": "^K(?:0[1-9]|[12][0-9])$",
            "type": "string"
          },
          "title": "Decision Refs",
          "type": "array"
        }
      },
      "required": [
        "provenance_id",
        "policy_id",
        "policy_version",
        "decision_refs"
      ],
      "title": "PolicyProvenance",
      "type": "object"
    },
    "PresetProvenance": {
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        },
        "kind": {
          "const": "PRESET",
          "default": "PRESET",
          "title": "Kind",
          "type": "string"
        },
        "preset_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Preset Id",
          "type": "string"
        },
        "preset_version": {
          "minLength": 1,
          "title": "Preset Version",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "preset_id",
        "preset_version"
      ],
      "title": "PresetProvenance",
      "type": "object"
    },
    "ProcessCode": {
