    "RoleEntry": {
      "additionalProperties": false,
      "properties": {
        "role_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Role Id",
          "type": "string"
        },
        "object_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectKind"
            },
            {
              "const": "SITE",
              "type": "string"
            }
          ],
          "title": "Object Scope"
        },
        "role_code": {
          "$ref": "#/$defs/RoleCode"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
