        "ITEM",
        "SQUARE_METER",
        "PICK",
        "DIGITAL_FLOW"
      ],
      "title": "ProcessQuantityKind",
      "type": "string"
    },
    "ProcessSchedule": {
      "additionalProperties": false,
      "properties": {
        "shifts_per_day": {
          "$ref": "#/$defs/KnownQuantity"
        },
        "shift_hours": {
          "$ref": "#/$defs/KnownQuantity"
        },
        "days_per_year": {
          "$ref": "#/$defs/KnownQuantity"
        }
      },
      "required": [
        "shifts_per_day",
        "shift_hours",
        "days_per_year"
      ],
      "title": "ProcessSchedule",
      "type": "object"
    },
    "ProcessScope": {
