{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robomera.local/contracts/scenario-spec-v1.schema.json",
  "title": "Robomera ScenarioSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "revision_id", "source", "template", "seed",
    "presentation", "facility", "zones", "fleet", "task_profiles",
    "economics", "assumptions", "warnings"
  ],
  "properties": {
    "schema_version": { "const": "scenario-spec-v1" },
    "revision_id": { "type": "string", "pattern": "^calc_[0-9a-f]{16}$" },
    "source": { "const": "calculation" },
    "template": { "enum": ["warehouse", "airport", "hospital"] },
    "seed": { "type": "string", "minLength": 1 },
    "presentation": { "$ref": "#/$defs/presentation" },
    "facility": { "$ref": "#/$defs/facility" },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/zone" }
    },
    "fleet": { "type": "array", "items": { "$ref": "#/$defs/fleetItem" } },
    "task_profiles": { "type": "array", "items": { "$ref": "#/$defs/taskProfile" } },
    "economics": { "$ref": "#/$defs/economics" },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autoplay", "default_camera_mode", "manual_control_available", "editor_available"],
      "properties": {
        "autoplay": { "type": "boolean" },
        "default_camera_mode": { "const": "AUTOPILOT" },
        "manual_control_available": { "type": "boolean" },
        "editor_available": { "type": "boolean" }
      }
    },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area_m2", "width_m", "depth_m", "geometry_status", "occupancy_percent"],
      "properties": {
        "area_m2": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "width_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "depth_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "geometry_status": { "enum": ["PROVIDED", "ASSUMED", "UNKNOWN"] },
        "occupancy_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "process_type", "cargo_type", "status",
        "demand_per_day", "avg_distance_m", "aisle_width_m", "polygon"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1 },
        "process_type": { "enum": ["transport", "palletizing", "cleaning", "delivery"] },
        "cargo_type": { "enum": ["pallets", "boxes", "cases", "carts", "deliveries"] },
        "status": { "enum": ["RECOMMENDED", "NO_ELIGIBLE_EQUIPMENT", "NO_ACCEPTABLE_ECONOMICS"] },
        "demand_per_day": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "avg_distance_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "aisle_width_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "polygon": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array", "minItems": 3,
              "items": {
                "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }],
                "items": false, "minItems": 2, "maxItems": 2
              }
            }
          ]
        }
      }
    },
    "fleetItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone_id", "equipment_model_id", "visual_profile", "quantity", "max_speed_m_s", "payload_kg"],
      "properties": {
        "zone_id": { "type": "string" },
        "equipment_model_id": { "type": "string" },
        "visual_profile": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "max_speed_m_s": { "type": "number", "minimum": 0 },
        "payload_kg": { "type": "number", "minimum": 0 }
      }
    },
    "taskProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone_id", "kind", "demand_per_day", "units_per_trip", "exchange_time_s"],
      "properties": {
        "zone_id": { "type": "string" },
        "kind": { "enum": ["pallet_move", "box_move", "cart_move", "delivery", "cleaning", "palletizing"] },
        "demand_per_day": { "type": "number", "exclusiveMinimum": 0 },
        "units_per_trip": { "type": "integer", "minimum": 1 },
        "exchange_time_s": { "type": "number", "minimum": 0 }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario", "horizon_years", "capex_rub", "annual_opex_rub",
        "annual_savings_rub", "payback_years", "npv_rub", "tco_rub",
        "fte_released", "confidence", "status"
      ],
      "properties": {
        "scenario": { "const": "base" },
        "horizon_years": { "type": "integer", "minimum": 5, "maximum": 10 },
        "capex_rub": { "type": "number" },
        "annual_opex_rub": { "type": "number" },
        "annual_savings_rub": { "type": "number" },
        "payback_years": { "type": ["number", "null"], "minimum": 0 },
        "npv_rub": { "type": "number" },
        "tco_rub": { "type": "number" },
        "fte_released": { "type": "number", "minimum": 0 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "status": { "enum": ["ACCEPTABLE", "WARNING", "NOT_ACCEPTABLE"] }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
