        },
        "utilization_fraction": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Utilization Fraction",
          "type": "string"
        },
        "wait_seconds": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Wait Seconds",
          "type": "string"
