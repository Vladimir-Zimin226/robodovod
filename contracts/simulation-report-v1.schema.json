          "title": "Denominator",
          "type": "string"
        },
        "deviation_percent": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deviation Percent"
        },
        "expected_effective_per_hour": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Expected Effective Per Hour",
          "type": "string"
        },
        "observed_per_hour": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Observed Per Hour",
          "type": "string"
        },
        "required_per_hour": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Required Per Hour",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "CONSISTENT",
            "DEVIATION",
            "OVERLOADED",
            "N_A",
            "INPUT_MISMATCH"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "warning_threshold_percent": {
          "const": "10",
          "default": "10",
          "title": "Warning Threshold Percent",
          "type": "string"
        }
      },
      "required": [
        "required_per_hour",
        "expected_effective_per_hour",
        "observed_per_hour",
        "unit",
        "deviation_percent",
        "verdict",
        "demand_shortfall_per_hour",
        "capacity_headroom_per_hour",
        "ceiling_verdict"
