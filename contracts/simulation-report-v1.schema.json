    "SimulationReplayV1": {
      "additionalProperties": false,
      "properties": {
        "canonical_request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Canonical Request Digest",
          "type": "string"
        },
        "report_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
