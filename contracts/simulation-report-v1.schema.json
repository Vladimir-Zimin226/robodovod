          "type": "integer"
        },
        "resource_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Resource Id",
          "type": "string"
        },
        "stage": {
          "enum": [
            "LOAD",
            "OUTBOUND",
            "WORK",
            "UNLOAD",
            "RETURN"
          ],
