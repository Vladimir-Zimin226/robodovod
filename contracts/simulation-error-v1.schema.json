{
  "$id": "https://robomera.local/contracts/simulation-error-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "CANCELLED",
        "TIMEOUT",
        "LIMIT_EXCEEDED",
        "INVALID_SCENARIO"
      ],
      "title": "Code",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "scenario_revision_id": {
      "pattern": "^calc_[0-9a-f]{16}$",
      "title": "Scenario Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": "simulation-error-v1",
      "default": "simulation-error-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "scenario_revision_id",
    "code",
    "message"
  ],
  "title": "Robomera SimulationError v1",
  "type": "object"
}
