{
  "$defs": {
    "CandidateScoreBreakdownV2": {
      "additionalProperties": false,
      "properties": {
        "applicability_components": {
          "items": {
            "$ref": "#/$defs/ComponentTraceV2"
          },
          "title": "Applicability Components",
          "type": "array"
        },
        "applicability_score": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applicability Score"
        },
        "candidate_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "configuration_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Configuration Id",
          "type": "string"
        },
        "data_score": {
          "$ref": "#/$defs/DataScoreTraceV2"
        },
        "economy_score": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Economy Score"
        },
        "eligibility": {
          "enum": [
            "EXCLUDED",
            "TECHNICAL_ONLY",
            "FULL"
          ],
          "title": "Eligibility",
          "type": "string"
        },
        "final_score": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Final Score"
        },
        "model_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Model Id",
          "type": "string"
        },
        "npv_project": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Npv Project"
        },
        "penalty": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Penalty",
          "type": "string"
        },
        "position_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Position Id",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rank"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "recommendation_quality": {
          "enum": [
            "FINAL",
            "PRELIMINARY",
            "EXCLUDED"
          ],
          "title": "Recommendation Quality",
          "type": "string"
        },
        "technical_score": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Technical Score"
        }
      },
      "required": [
        "candidate_id",
        "configuration_id",
        "model_id",
        "position_id",
        "eligibility",
        "recommendation_quality",
        "applicability_components",
        "applicability_score",
        "data_score",
        "economy_score",
        "npv_project",
        "penalty",
        "technical_score",
        "final_score",
        "rank",
        "reason_codes"
      ],
      "title": "CandidateScoreBreakdownV2",
      "type": "object"
    },
    "ComponentTraceV2": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "enum": [
            "availability",
            "integrations",
            "aisle_margin",
            "trl",
            "payload_margin"
          ],
          "title": "Component Id",
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator"
        },
        "effective_weight": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Effective Weight",
          "type": "string"
        },
        "knots": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
                "type": "string"
              },
              {
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Knots",
          "type": "array"
        },
        "nominal_weight": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Nominal Weight",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Value"
        },
        "numerator": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numerator"
        },
        "provenance_refs": {
          "items": {
            "type": "string"
          },
          "title": "Provenance Refs",
          "type": "array"
        },
        "raw_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Value"
        },
        "status": {
          "enum": [
            "VALUE",
            "UNKNOWN",
            "N_A"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "status",
        "raw_value",
        "normalized_value",
        "nominal_weight",
        "effective_weight",
        "numerator",
        "denominator",
        "knots",
        "provenance_refs"
      ],
      "title": "ComponentTraceV2",
      "type": "object"
    },
    "DataScoreTraceV2": {
      "additionalProperties": false,
      "properties": {
        "applicable_field_count": {
          "maximum": 36,
          "minimum": 0,
          "title": "Applicable Field Count",
          "type": "integer"
        },
        "denominator": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Denominator",
          "type": "string"
        },
        "missing_weight": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Missing Weight",
          "type": "string"
        },
        "numerator": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Numerator",
          "type": "string"
        },
        "status": {
          "enum": [
            "VALUE",
            "N_A"
          ],
          "title": "Status",
          "type": "string"
        },
        "unverified_weight": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Unverified Weight",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "verified_weight": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Verified Weight",
          "type": "string"
        }
      },
      "required": [
        "status",
        "numerator",
        "denominator",
        "value",
        "verified_weight",
        "unverified_weight",
        "missing_weight",
        "applicable_field_count"
      ],
      "title": "DataScoreTraceV2",
      "type": "object"
    },
    "RankingReplayV2": {
      "additionalProperties": false,
      "properties": {
        "allocation_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Allocation Result Digest",
          "type": "string"
        },
        "canonical_input_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Canonical Input Digest",
          "type": "string"
        },
        "constraint_report_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Constraint Report Digests",
          "type": "array"
        },
        "executability_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Executability Digests",
          "type": "array"
        },
        "trace_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Trace Content Digest",
          "type": "string"
        }
      },
      "required": [
        "canonical_input_digest",
        "allocation_result_digest",
        "constraint_report_digests",
        "executability_digests",
        "trace_content_digest"
      ],
      "title": "RankingReplayV2",
      "type": "object"
    },
    "RankingTraceNodeV2": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "formula_id": {
          "enum": [
            "F33",
            "F35"
          ],
          "title": "Formula Id",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "node_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "operation": {
          "enum": [
            "ELIGIBILITY",
            "INTERPOLATE",
            "REWEIGHT",
            "DATA_COMPLETENESS",
            "ECONOMY_MINMAX",
            "PENALTY",
            "FINAL_SCORE",
            "RECOMMENDATION"
          ],
          "title": "Operation",
          "type": "string"
        },
        "output_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Output Ref",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "node_id",
        "formula_id",
        "operation",
        "input_refs",
        "output_ref",
        "value"
      ],
      "title": "RankingTraceNodeV2",
      "type": "object"
    },
    "RankingVersionsV2": {
      "additionalProperties": false,
      "properties": {
        "allocation_result_version": {
          "const": "multiprocess-allocation-result-v1",
          "default": "multiprocess-allocation-result-v1",
          "title": "Allocation Result Version",
          "type": "string"
        },
        "calculation_policy_version": {
          "const": "hackathon-calculation-policy-v1",
          "default": "hackathon-calculation-policy-v1",
          "title": "Calculation Policy Version",
          "type": "string"
        },
        "constraint_rules_version": {
          "const": "calculation-constraint-rules-v2",
          "default": "calculation-constraint-rules-v2",
          "title": "Constraint Rules Version",
          "type": "string"
        },
        "data_field_registry_version": {
          "const": "ranking-data-fields-r08-k16-v1",
          "default": "ranking-data-fields-r08-k16-v1",
          "title": "Data Field Registry Version",
          "type": "string"
        },
        "engine_version": {
          "const": "ranking-v2",
          "default": "ranking-v2",
          "title": "Engine Version",
          "type": "string"
        },
        "executability_version": {
          "const": "formula-run-executability-v3",
          "default": "formula-run-executability-v3",
          "title": "Executability Version",
          "type": "string"
        },
        "policy_overlay_version": {
          "const": "hackathon-calculation-policy-v1+v2d-c19",
          "default": "hackathon-calculation-policy-v1+v2d-c19",
          "title": "Policy Overlay Version",
          "type": "string"
        },
        "precision_policy_version": {
          "const": "decimal-context-28-half-even-v1",
          "default": "decimal-context-28-half-even-v1",
          "title": "Precision Policy Version",
          "type": "string"
        },
        "request_version": {
          "const": "ranking-request-v2",
          "default": "ranking-request-v2",
          "title": "Request Version",
          "type": "string"
        },
        "result_version": {
          "const": "ranking-result-v2",
          "default": "ranking-result-v2",
          "title": "Result Version",
          "type": "string"
        }
      },
      "title": "RankingVersionsV2",
      "type": "object"
    },
    "RecommendationV2": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Id"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "enum": [
            "RECOMMENDED",
            "PRELIMINARY",
            "NO_POSITIVE_CASE",
            "INCOMPLETE",
            "NONE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "candidate_id",
        "reason_codes"
      ],
      "title": "RecommendationV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anchor_configuration_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Anchor Configuration Id",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateScoreBreakdownV2"
      },
      "title": "Candidates",
      "type": "array"
    },
    "cohort_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Cohort Id",
      "type": "string"
    },
    "financial_recommendation": {
      "$ref": "#/$defs/RecommendationV2"
    },
    "input_revision": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Input Revision",
      "type": "string"
    },
    "process_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Process Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "replay": {
      "$ref": "#/$defs/RankingReplayV2"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ranking-result-v2",
      "default": "ranking-result-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "technical_recommendation": {
      "$ref": "#/$defs/RecommendationV2"
    },
    "tenant_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/RankingTraceNodeV2"
      },
      "title": "Trace",
      "type": "array"
    },
    "versions": {
      "$ref": "#/$defs/RankingVersionsV2"
    },
    "warnings": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "tenant_id",
    "input_revision",
    "process_id",
    "cohort_id",
    "anchor_configuration_id",
    "candidates",
    "technical_recommendation",
    "financial_recommendation",
    "warnings",
    "trace",
    "versions",
    "replay"
  ],
  "title": "RankingResultV2",
  "type": "object"
}
