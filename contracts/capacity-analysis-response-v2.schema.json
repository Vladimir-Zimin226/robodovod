{
  "$defs": {
    "AssumptionProvenance": {
      "additionalProperties": false,
      "properties": {
        "assumption_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Assumption Id",
          "type": "string"
        },
        "assumption_version": {
          "minLength": 1,
          "title": "Assumption Version",
          "type": "string"
        },
        "confirmation_state": {
          "enum": [
            "POLICY_ACCEPTED",
            "USER_CONFIRMED"
          ],
          "title": "Confirmation State",
          "type": "string"
        },
        "kind": {
          "const": "ASSUMPTION",
          "default": "ASSUMPTION",
          "title": "Kind",
          "type": "string"
        },
        "permitted_scope": {
          "minLength": 1,
          "title": "Permitted Scope",
          "type": "string"
        },
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "assumption_id",
        "assumption_version",
        "rationale",
        "permitted_scope",
        "confirmation_state"
      ],
      "title": "AssumptionProvenance",
      "type": "object"
    },
    "AssumptionUse": {
      "additionalProperties": false,
      "properties": {
        "applicable_scenario": {
          "enum": [
            "ALL",
            "PESSIMISTIC",
            "BASE",
            "OPTIMISTIC"
          ],
          "title": "Applicable Scenario",
          "type": "string"
        },
        "assumption_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Assumption Id",
          "type": "string"
        },
        "assumption_version": {
          "minLength": 1,
          "title": "Assumption Version",
          "type": "string"
        },
        "confirmation_state": {
          "enum": [
            "POLICY_ACCEPTED",
            "USER_CONFIRMED"
          ],
          "title": "Confirmation State",
          "type": "string"
        },
        "mode": {
          "enum": [
            "DEFAULT",
            "OVERRIDE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "permitted_scope": {
          "minLength": 1,
          "title": "Permitted Scope",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "raw_user_override": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw User Override"
        }
      },
      "required": [
        "assumption_id",
        "assumption_version",
        "provenance_ref",
        "rationale",
        "permitted_scope",
        "mode",
        "raw_user_override",
        "applicable_scenario",
        "confirmation_state"
      ],
      "title": "AssumptionUse",
      "type": "object"
    },
    "BlockerReason": {
      "enum": [
        "MISSING_INPUT",
        "UNIT_MISMATCH",
        "UNSUPPORTED_PROCESS_PROFILE",
        "MISSING_SAFE_FACT",
        "CONFLICTING_FACT",
        "UNAPPROVED_ASSUMPTION",
        "INVALID_DOMAIN",
        "UNKNOWN_POLICY_VERSION",
        "MISSING_COMMERCIAL_TERMS",
        "MISSING_ROLE_SALARY",
        "UNKNOWN_TAX_BASIS"
      ],
      "title": "BlockerReason",
      "type": "string"
    },
    "CalculationTrace": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/AssumptionUse"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/ConstraintEvaluation"
          },
          "title": "Constraints",
          "type": "array"
        },
        "conversions": {
          "items": {
            "$ref": "#/$defs/UnitConversion"
          },
          "title": "Conversions",
          "type": "array"
        },
        "envelope": {
          "$ref": "#/$defs/TraceEnvelope"
        },
        "formula_nodes": {
          "items": {
            "$ref": "#/$defs/FormulaNode"
          },
          "title": "Formula Nodes",
          "type": "array"
        },
        "inputs": {
          "items": {
            "discriminator": {
              "mapping": {
                "KNOWN": "#/$defs/KnownQuantity",
                "MISSING": "#/$defs/MissingQuantity"
              },
              "propertyName": "status"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KnownQuantity"
              },
              {
                "$ref": "#/$defs/MissingQuantity"
              }
            ]
          },
          "title": "Inputs",
          "type": "array"
        },
        "intermediates": {
          "items": {
            "$ref": "#/$defs/IntermediateValue"
          },
          "title": "Intermediates",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ContractIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "provenance": {
          "items": {
            "discriminator": {
              "mapping": {
                "ASSUMPTION": "#/$defs/AssumptionProvenance",
                "DERIVED": "#/$defs/DerivedProvenance",
                "FILE": "#/$defs/FileProvenance",
                "POLICY": "#/$defs/PolicyProvenance",
                "PRESET": "#/$defs/PresetProvenance",
                "USER": "#/$defs/UserProvenance",
                "VENDOR_FACT": "#/$defs/VendorFactProvenance"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/UserProvenance"
              },
              {
                "$ref": "#/$defs/FileProvenance"
              },
              {
                "$ref": "#/$defs/PresetProvenance"
              },
              {
                "$ref": "#/$defs/VendorFactProvenance"
              },
              {
                "$ref": "#/$defs/AssumptionProvenance"
              },
              {
                "$ref": "#/$defs/PolicyProvenance"
              },
              {
                "$ref": "#/$defs/DerivedProvenance"
              }
            ]
          },
          "title": "Provenance",
          "type": "array"
        },
        "replay": {
          "$ref": "#/$defs/ReplayBinding"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/TraceResult"
          },
          "title": "Results",
          "type": "array"
        },
        "roundings": {
          "items": {
            "$ref": "#/$defs/RoundingEvent"
          },
          "title": "Roundings",
          "type": "array"
        },
        "runtime_metadata": {
          "$ref": "#/$defs/RuntimeMetadata"
        },
        "versions": {
          "$ref": "#/$defs/VersionBindings"
        }
      },
      "required": [
        "envelope",
        "versions",
        "provenance",
        "inputs",
        "formula_nodes",
        "results",
        "replay"
      ],
      "title": "CalculationTrace",
      "type": "object"
    },
    "CapacityResult": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "$ref": "#/$defs/ContractIssue"
          },
          "title": "Blockers",
          "type": "array"
        },
        "process_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Process Id",
          "type": "string"
        },
        "schema_version": {
          "const": "capacity-result-v1",
          "default": "capacity-result-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "WITH_ASSUMPTIONS",
            "BLOCKED",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "trace_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Trace Ref",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapacityValues"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ContractIssue"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "process_id",
        "status",
        "value",
        "trace_ref"
      ],
      "title": "CapacityResult",
      "type": "object"
    },
    "CapacityValues": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/ResultQuantity"
        },
        "effective_capacity": {
          "$ref": "#/$defs/ResultQuantity"
        },
        "nominal_capacity": {
          "$ref": "#/$defs/ResultQuantity"
        },
        "overloaded": {
          "title": "Overloaded",
          "type": "boolean"
        },
        "raw_load_ratio": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_fleet": {
          "minimum": 0,
          "title": "Recommended Fleet",
          "type": "integer"
        },
        "selected_fleet": {
          "minimum": 0,
          "title": "Selected Fleet",
          "type": "integer"
        },
        "utilization": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultQuantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "recommended_fleet",
        "selected_fleet",
        "nominal_capacity",
        "effective_capacity",
        "coverage",
        "raw_load_ratio",
        "utilization",
        "overloaded"
      ],
      "title": "CapacityValues",
      "type": "object"
    },
    "ConstraintEvaluation": {
      "additionalProperties": false,
      "properties": {
        "available_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Ref"
        },
        "check_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "check_version": {
          "minLength": 1,
          "title": "Check Version",
          "type": "string"
        },
        "criticality": {
          "enum": [
            "CRITICAL",
            "ADVISORY"
          ],
          "title": "Criticality",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "prerequisite_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prerequisite Refs",
          "type": "array"
        },
        "reason_code": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "required_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Required Ref"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "ASSUMED",
            "N_A"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "check_id",
        "check_version",
        "required_ref",
        "available_ref",
        "status",
        "criticality",
        "reason_code",
        "scope"
      ],
      "title": "ConstraintEvaluation",
      "type": "object"
    },
    "ContractIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "decision_refs": {
          "items": {
            "pattern": "^K(?:0[1-9]|[12][0-9])$",
            "type": "string"
          },
          "title": "Decision Refs",
          "type": "array"
        },
        "field_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Field Refs",
          "type": "array"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "node_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Node Refs",
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/BlockerReason"
        },
        "severity": {
          "enum": [
            "WARNING",
            "BLOCKER"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "reason",
        "severity",
        "field_refs",
        "message"
      ],
      "title": "ContractIssue",
      "type": "object"
    },
    "DerivedProvenance": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "DERIVED",
          "default": "DERIVED",
          "title": "Kind",
          "type": "string"
        },
        "parent_node_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Parent Node Ids",
          "type": "array"
        },
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "parent_node_ids"
      ],
      "title": "DerivedProvenance",
      "type": "object"
    },
    "FileProvenance": {
      "additionalProperties": false,
      "properties": {
        "file_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "File Digest",
          "type": "string"
        },
        "kind": {
          "const": "FILE",
          "default": "FILE",
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "file_digest",
        "locator"
      ],
      "title": "FileProvenance",
      "type": "object"
    },
    "FormulaNode": {
      "additionalProperties": false,
      "properties": {
        "applicability_domain": {
          "minLength": 1,
          "title": "Applicability Domain",
          "type": "string"
        },
        "dependency_node_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Dependency Node Ids",
          "type": "array"
        },
        "formula_id": {
          "pattern": "^F(?:0[1-9]|[12][0-9]|3[0-5])$",
          "title": "Formula Id",
          "type": "string"
        },
        "formula_version": {
          "minLength": 1,
          "title": "Formula Version",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "node_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "template_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Template Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "formula_id",
        "formula_version",
        "source_refs",
        "source_digest",
        "template_id",
        "applicability_domain"
      ],
      "title": "FormulaNode",
      "type": "object"
    },
    "IntermediateValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/QuantityName"
        },
        "node_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "parent_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Refs",
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/ResultQuantity"
        },
        "value_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Value Id",
          "type": "string"
        }
      },
      "required": [
        "value_id",
        "node_id",
        "name",
        "value",
        "parent_refs"
      ],
      "title": "IntermediateValue",
      "type": "object"
    },
    "KnownQuantity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/QuantityName"
        },
        "normalized_value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Normalized Value",
          "type": "string"
        },
        "numeric_encoding": {
          "const": "DECIMAL_STRING",
          "default": "DECIMAL_STRING",
          "title": "Numeric Encoding",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "raw_unit": {
          "$ref": "#/$defs/Unit"
        },
        "raw_value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Raw Value",
          "type": "string"
        },
        "status": {
          "const": "KNOWN",
          "default": "KNOWN",
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "name",
        "raw_value",
        "raw_unit",
        "normalized_value",
        "unit",
        "quantity_kind",
        "provenance_ref"
      ],
      "title": "KnownQuantity",
      "type": "object"
    },
    "MissingQuantity": {
      "additionalProperties": false,
      "properties": {
        "expected_unit": {
          "$ref": "#/$defs/Unit"
        },
        "missing_reason": {
          "$ref": "#/$defs/MissingReason"
        },
        "name": {
          "$ref": "#/$defs/QuantityName"
        },
        "provenance_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Ref"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "status": {
          "const": "MISSING",
          "default": "MISSING",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "quantity_kind",
        "expected_unit",
        "missing_reason"
      ],
      "title": "MissingQuantity",
      "type": "object"
    },
    "MissingReason": {
      "enum": [
        "MISSING_INPUT",
        "MISSING_SAFE_FACT",
        "UNIT_MISMATCH",
        "CONFLICTING_FACT",
        "UNAPPROVED_ASSUMPTION",
        "NOT_APPLICABLE"
      ],
      "title": "MissingReason",
      "type": "string"
    },
    "PolicyProvenance": {
      "additionalProperties": false,
      "properties": {
        "decision_refs": {
          "items": {
            "pattern": "^K(?:0[1-9]|[12][0-9])$",
            "type": "string"
          },
          "title": "Decision Refs",
          "type": "array"
        },
        "kind": {
          "const": "POLICY",
          "default": "POLICY",
          "title": "Kind",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "policy_id",
        "policy_version",
        "decision_refs"
      ],
      "title": "PolicyProvenance",
      "type": "object"
    },
    "PresetProvenance": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "PRESET",
          "default": "PRESET",
          "title": "Kind",
          "type": "string"
        },
        "preset_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Preset Id",
          "type": "string"
        },
        "preset_version": {
          "minLength": 1,
          "title": "Preset Version",
          "type": "string"
        },
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Id",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "preset_id",
        "preset_version"
      ],
      "title": "PresetProvenance",
      "type": "object"
    },
    "QuantityKind": {
