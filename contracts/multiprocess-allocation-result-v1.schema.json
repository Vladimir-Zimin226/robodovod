{
  "$defs": {
    "AllocationMetricV1": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "NOT_REACHED"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "RUB",
            "YEAR"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
              "type": "string"
            },
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "status",
        "value",
        "unit"
      ],
      "title": "AllocationMetricV1",
      "type": "object"
    },
    "AllocationReplayV1": {
      "additionalProperties": false,
      "properties": {
        "canonical_input_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Canonical Input Digest",
          "type": "string"
        },
        "labour_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Labour Result Digest",
          "type": "string"
        },
        "source_result_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Result Digests",
          "type": "array"
        },
        "trace_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Trace Content Digest",
          "type": "string"
        }
      },
      "required": [
        "canonical_input_digest",
        "labour_result_digest",
        "source_result_digests",
        "trace_content_digest"
      ],
      "title": "AllocationReplayV1",
      "type": "object"
    },
    "AllocationTraceNodeV1": {
      "additionalProperties": false,
      "properties": {
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "node_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "ALLOCATE_SITE_CAPITAL",
            "ALLOCATE_OBJECT_FOT",
            "ALLOCATE_SHARED_COST",
            "COMBINE_CASHFLOW",
            "PROJECT_METRIC"
          ],
          "title": "Operation",
          "type": "string"
        },
        "output_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Output Ref",
          "type": "string"
        },
        "rounding": {
          "default": "NONE",
          "enum": [
            "NONE",
            "HALF_EVEN_CENT_LARGEST_REMAINDER"
          ],
          "title": "Rounding",
          "type": "string"
        },
        "unit": {
          "enum": [
            "RUB",
            "PERSON",
            "YEAR"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "node_id",
        "operation",
        "input_refs",
        "output_ref",
        "value",
        "unit"
      ],
      "title": "AllocationTraceNodeV1",
      "type": "object"
    },
    "AllocationVersionBindingsV1": {
      "additionalProperties": false,
      "properties": {
        "calculation_policy_version": {
          "const": "hackathon-calculation-policy-v1",
          "default": "hackathon-calculation-policy-v1",
          "title": "Calculation Policy Version",
          "type": "string"
        },
        "engine_version": {
          "const": "multiprocess-allocation-v1",
          "default": "multiprocess-allocation-v1",
          "title": "Engine Version",
          "type": "string"
        },
        "labour_policy_overlay_version": {
          "const": "hackathon-calculation-policy-v1+v2a-c14",
          "default": "hackathon-calculation-policy-v1+v2a-c14",
          "title": "Labour Policy Overlay Version",
          "type": "string"
        },
        "precision_policy_version": {
          "const": "decimal-context-28-half-even-v1",
          "default": "decimal-context-28-half-even-v1",
          "title": "Precision Policy Version",
          "type": "string"
        },
        "registry_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Registry Digest",
          "type": "string"
        },
        "registry_version": {
          "const": "hackathon-calculation-parameter-registry-v1",
          "title": "Registry Version",
          "type": "string"
        },
        "request_version": {
          "const": "multiprocess-allocation-request-v1",
          "default": "multiprocess-allocation-request-v1",
          "title": "Request Version",
          "type": "string"
        },
        "result_version": {
          "const": "multiprocess-allocation-result-v1",
          "default": "multiprocess-allocation-result-v1",
          "title": "Result Version",
          "type": "string"
        }
      },
      "required": [
        "registry_version",
        "registry_digest"
      ],
      "title": "AllocationVersionBindingsV1",
      "type": "object"
    },
    "ProcessAllocationResultV1": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "enum": [
            "PURCHASE",
            "RAAS"
          ],
          "title": "Acquisition",
          "type": "string"
        },
        "allocated_role_people": {
          "minimum": 0,
          "title": "Allocated Role People",
          "type": "integer"
        },
        "allocated_shared_capex_cashflow": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Allocated Shared Capex Cashflow",
          "type": "string"
        },
        "annual_ledgers": {
          "items": {
            "$ref": "#/$defs/ProcessAnnualAllocationV1"
          },
          "title": "Annual Ledgers",
          "type": "array"
        },
        "capital_allocation_basis": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Capital Allocation Basis",
          "type": "string"
        },
        "capital_allocation_method": {
          "enum": [
            "DIRECT_CAPITAL_LARGEST_REMAINDER",
            "EQUAL_ZERO_DENOMINATOR"
          ],
          "title": "Capital Allocation Method",
          "type": "string"
        },
        "combined_capex_cashflow": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Combined Capex Cashflow",
          "type": "string"
        },
        "configuration_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Configuration Id",
          "type": "string"
        },
        "model_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Model Id",
          "type": "string"
        },
        "position_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Position Id",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Process Id",
          "type": "string"
        },
        "released_role_people": {
          "minimum": 0,
          "title": "Released Role People",
          "type": "integer"
        },
        "source_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Result Digest",
          "type": "string"
        },
        "source_run_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Source Run Id",
          "type": "string"
        }
      },
      "required": [
        "configuration_id",
        "process_id",
        "model_id",
        "position_id",
        "acquisition",
        "source_run_id",
        "source_result_digest",
        "capital_allocation_basis",
        "capital_allocation_method",
        "allocated_shared_capex_cashflow",
        "combined_capex_cashflow",
        "allocated_role_people",
        "released_role_people",
        "annual_ledgers"
      ],
      "title": "ProcessAllocationResultV1",
      "type": "object"
    },
    "ProcessAnnualAllocationV1": {
      "additionalProperties": false,
      "properties": {
        "allocated_baseline_fot": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Allocated Baseline Fot",
          "type": "string"
        },
        "allocated_scenario_fot": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Allocated Scenario Fot",
          "type": "string"
        },
        "allocated_shared_baseline_cost": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Allocated Shared Baseline Cost",
          "type": "string"
        },
        "allocated_shared_scenario_cost": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Allocated Shared Scenario Cost",
          "type": "string"
        },
        "combined_baseline_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Combined Baseline Cf",
          "type": "string"
        },
        "combined_scenario_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Combined Scenario Cf",
          "type": "string"
        },
        "differential_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Differential Cf",
          "type": "string"
        },
        "direct_baseline_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Direct Baseline Cf",
          "type": "string"
        },
        "direct_scenario_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Direct Scenario Cf",
          "type": "string"
        },
        "year": {
          "maximum": 15,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "direct_baseline_cf",
        "direct_scenario_cf",
        "allocated_baseline_fot",
        "allocated_scenario_fot",
        "allocated_shared_baseline_cost",
        "allocated_shared_scenario_cost",
        "combined_baseline_cf",
        "combined_scenario_cf",
        "differential_cf"
      ],
      "title": "ProcessAnnualAllocationV1",
      "type": "object"
    },
    "ProjectAnnualLedgerV1": {
      "additionalProperties": false,
      "properties": {
        "combined_baseline_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Combined Baseline Cf",
          "type": "string"
        },
        "combined_scenario_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Combined Scenario Cf",
          "type": "string"
        },
        "differential_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Differential Cf",
          "type": "string"
        },
        "object_baseline_fot": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Object Baseline Fot",
          "type": "string"
        },
        "object_scenario_fot": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Object Scenario Fot",
          "type": "string"
        },
        "process_direct_baseline_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Process Direct Baseline Cf",
          "type": "string"
        },
        "process_direct_scenario_cf": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Process Direct Scenario Cf",
          "type": "string"
        },
        "shared_baseline_cost": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Shared Baseline Cost",
          "type": "string"
        },
        "shared_scenario_cost": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
          "title": "Shared Scenario Cost",
          "type": "string"
        },
        "year": {
          "maximum": 15,
          "minimum": 1,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "year",
        "process_direct_baseline_cf",
        "process_direct_scenario_cf",
        "object_baseline_fot",
        "object_scenario_fot",
        "shared_baseline_cost",
        "shared_scenario_cost",
        "combined_baseline_cf",
        "combined_scenario_cf",
        "differential_cf"
      ],
      "title": "ProjectAnnualLedgerV1",
      "type": "object"
    },
    "RoleConservationV1": {
      "additionalProperties": false,
      "properties": {
        "allocated_people": {
          "minimum": 0,
          "title": "Allocated People",
          "type": "integer"
        },
        "conserved": {
          "const": true,
          "default": true,
          "title": "Conserved",
          "type": "boolean"
        },
        "headcount": {
          "minimum": 0,
          "title": "Headcount",
          "type": "integer"
        },
        "released": {
          "minimum": 0,
          "title": "Released",
          "type": "integer"
        },
        "remaining": {
          "minimum": 0,
          "title": "Remaining",
          "type": "integer"
        },
        "role_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Role Id",
          "type": "string"
        },
        "transferred": {
          "minimum": 0,
          "title": "Transferred",
          "type": "integer"
        },
        "unallocated_people": {
          "minimum": 0,
          "title": "Unallocated People",
          "type": "integer"
        }
      },
      "required": [
        "role_id",
        "headcount",
        "allocated_people",
        "unallocated_people",
        "transferred",
        "released",
        "remaining"
      ],
      "title": "RoleConservationV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annual_ledgers": {
      "items": {
        "$ref": "#/$defs/ProjectAnnualLedgerV1"
      },
      "title": "Annual Ledgers",
      "type": "array"
    },
    "cohort_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Cohort Id",
      "type": "string"
    },
    "control_required_once": {
      "minimum": 0,
      "title": "Control Required Once",
      "type": "integer"
    },
    "discounted_payback": {
      "$ref": "#/$defs/AllocationMetricV1"
    },
    "horizon_years": {
      "maximum": 15,
      "minimum": 5,
      "title": "Horizon Years",
      "type": "integer"
    },
    "initial_baseline_cf": {
      "const": "0.00",
      "default": "0.00",
      "title": "Initial Baseline Cf",
      "type": "string"
    },
    "initial_scenario_cf": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
      "title": "Initial Scenario Cf",
      "type": "string"
    },
    "input_revision": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Input Revision",
      "type": "string"
    },
    "npv_base": {
      "$ref": "#/$defs/AllocationMetricV1"
    },
    "npv_project": {
      "$ref": "#/$defs/AllocationMetricV1"
    },
    "npv_scenario": {
      "$ref": "#/$defs/AllocationMetricV1"
    },
    "object_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "processes": {
      "items": {
        "$ref": "#/$defs/ProcessAllocationResultV1"
      },
      "title": "Processes",
      "type": "array"
    },
    "project_capex_cashflow": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
      "title": "Project Capex Cashflow",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "replay": {
      "$ref": "#/$defs/AllocationReplayV1"
    },
    "role_conservation": {
      "items": {
        "$ref": "#/$defs/RoleConservationV1"
      },
      "title": "Role Conservation",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "multiprocess-allocation-result-v1",
      "default": "multiprocess-allocation-result-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "shared_capex_cashflow": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$",
      "title": "Shared Capex Cashflow",
      "type": "string"
    },
    "simple_payback": {
      "$ref": "#/$defs/AllocationMetricV1"
    },
    "status": {
      "const": "COMPLETE",
      "default": "COMPLETE",
      "title": "Status",
      "type": "string"
    },
    "technicians_required_once": {
      "minimum": 0,
      "title": "Technicians Required Once",
      "type": "integer"
    },
    "tenant_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "total_released_people": {
      "minimum": 0,
      "title": "Total Released People",
      "type": "integer"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/AllocationTraceNodeV1"
      },
      "title": "Trace",
      "type": "array"
    },
    "unallocated_role_people": {
      "minimum": 0,
      "title": "Unallocated Role People",
      "type": "integer"
    },
    "versions": {
      "$ref": "#/$defs/AllocationVersionBindingsV1"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "tenant_id",
    "input_revision",
    "object_id",
    "cohort_id",
    "horizon_years",
    "processes",
    "role_conservation",
    "unallocated_role_people",
    "total_released_people",
    "control_required_once",
    "technicians_required_once",
    "shared_capex_cashflow",
    "project_capex_cashflow",
    "initial_scenario_cf",
    "annual_ledgers",
    "npv_base",
    "npv_scenario",
    "npv_project",
    "simple_payback",
    "discounted_payback",
    "trace",
    "versions",
    "replay"
  ],
  "title": "MultiprocessAllocationResultV1",
  "type": "object"
}
