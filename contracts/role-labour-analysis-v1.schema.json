{
  "$defs": {
    "CapacityLabourProjectionV1": {
      "additionalProperties": false,
      "description": "Read-only projection of a C07-C11 result; no capacity arithmetic here.",
      "properties": {
        "capacity_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Capacity Result Digest",
          "type": "string"
        },
        "capacity_run_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Capacity Run Id",
          "type": "string"
        },
        "capacity_status": {
          "enum": [
            "COMPLETE",
            "WITH_ASSUMPTIONS",
            "BLOCKED",
            "NOT_APPLICABLE"
          ],
          "title": "Capacity Status",
          "type": "string"
        },
        "coverage": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coverage"
        },
        "input_revision": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Input Revision",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Process Id",
          "type": "string"
        },
        "schema_version": {
          "const": "capacity-labour-projection-v1",
          "default": "capacity-labour-projection-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_fleet": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Fleet"
        }
      },
      "required": [
        "process_id",
        "input_revision",
        "capacity_run_id",
        "capacity_status",
        "selected_fleet",
        "coverage",
        "capacity_result_digest"
      ],
      "title": "CapacityLabourProjectionV1",
      "type": "object"
    },
    "DeficitCostInputV1": {
      "additionalProperties": false,
      "properties": {
        "annual_cost_per_person": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Annual Cost Per Person",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "role_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Role Id",
          "type": "string"
        },
        "semantics": {
          "enum": [
            "MONETIZE",
            "DEFICIT_NOT_MONETIZED"
          ],
          "title": "Semantics",
          "type": "string"
        },
        "source": {
          "enum": [
            "USER",
            "FILE"
          ],
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "const": "RUB/person/year",
          "default": "RUB/person/year",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "role_id",
        "annual_cost_per_person",
        "semantics",
        "source",
        "provenance_ref"
      ],
      "title": "DeficitCostInputV1",
      "type": "object"
    },
    "KnownQuantity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/QuantityName"
        },
        "normalized_value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Normalized Value",
          "type": "string"
        },
        "numeric_encoding": {
          "const": "DECIMAL_STRING",
          "default": "DECIMAL_STRING",
          "title": "Numeric Encoding",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "raw_unit": {
          "$ref": "#/$defs/Unit"
        },
        "raw_value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Raw Value",
          "type": "string"
        },
        "status": {
          "const": "KNOWN",
          "default": "KNOWN",
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "name",
        "raw_value",
        "raw_unit",
        "normalized_value",
        "unit",
        "quantity_kind",
        "provenance_ref"
      ],
      "title": "KnownQuantity",
      "type": "object"
    },
    "ManualProductivityInputV1": {
      "additionalProperties": false,
      "properties": {
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "source": {
          "enum": [
            "USER",
            "FILE"
          ],
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "source",
        "provenance_ref"
      ],
      "title": "ManualProductivityInputV1",
      "type": "object"
    },
    "MissingQuantity": {
      "additionalProperties": false,
      "properties": {
        "expected_unit": {
          "$ref": "#/$defs/Unit"
        },
        "missing_reason": {
          "$ref": "#/$defs/MissingReason"
        },
        "name": {
          "$ref": "#/$defs/QuantityName"
        },
        "provenance_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Ref"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "status": {
          "const": "MISSING",
          "default": "MISSING",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "quantity_kind",
        "expected_unit",
        "missing_reason"
      ],
      "title": "MissingQuantity",
      "type": "object"
    },
    "MissingReason": {
      "enum": [
        "MISSING_INPUT",
        "MISSING_SAFE_FACT",
        "UNIT_MISMATCH",
        "CONFLICTING_FACT",
        "UNAPPROVED_ASSUMPTION",
        "NOT_APPLICABLE"
      ],
      "title": "MissingReason",
      "type": "string"
    },
    "NormalizedProcess": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "demand": {
          "discriminator": {
            "mapping": {
              "KNOWN": "#/$defs/KnownQuantity",
              "MISSING": "#/$defs/MissingQuantity"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/KnownQuantity"
            },
            {
              "$ref": "#/$defs/MissingQuantity"
            }
          ],
          "title": "Demand"
        },
        "exchange": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "SPLIT": "#/$defs/SplitExchange",
                  "TOTAL": "#/$defs/TotalExchange"
                },
                "propertyName": "mode"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TotalExchange"
                },
                {
                  "$ref": "#/$defs/SplitExchange"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "explicit_batch": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "KNOWN": "#/$defs/KnownQuantity",
                  "MISSING": "#/$defs/MissingQuantity"
                },
                "propertyName": "status"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/KnownQuantity"
                },
                {
                  "$ref": "#/$defs/MissingQuantity"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explicit Batch"
        },
        "input_revision": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Input Revision",
          "type": "string"
        },
        "item_mass": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "KNOWN": "#/$defs/KnownQuantity",
                  "MISSING": "#/$defs/MissingQuantity"
                },
                "propertyName": "status"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/KnownQuantity"
                },
                {
                  "$ref": "#/$defs/MissingQuantity"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Mass"
        },
        "object_kind": {
          "$ref": "#/$defs/ObjectKind"
        },
        "process_code": {
          "$ref": "#/$defs/ProcessCode"
        },
        "process_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Process Id",
          "type": "string"
        },
        "quantity_kind": {
          "$ref": "#/$defs/ProcessQuantityKind"
        },
        "role_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Role Refs",
          "type": "array"
        },
        "route_distance": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "KNOWN": "#/$defs/KnownQuantity",
                  "MISSING": "#/$defs/MissingQuantity"
                },
                "propertyName": "status"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/KnownQuantity"
                },
                {
                  "$ref": "#/$defs/MissingQuantity"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Distance"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessSchedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "normalized-process-v1",
          "default": "normalized-process-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ProcessScope"
        }
      },
      "required": [
        "process_id",
        "input_revision",
        "object_kind",
        "process_code",
        "scope",
        "active",
        "quantity_kind",
        "demand"
      ],
      "title": "NormalizedProcess",
      "type": "object"
    },
