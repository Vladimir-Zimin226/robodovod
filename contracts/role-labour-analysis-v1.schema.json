          },
          "oneOf": [
            {
              "$ref": "#/$defs/KnownQuantity"
            },
            {
              "$ref": "#/$defs/MissingQuantity"
            }
          ],
          "title": "Headcount"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
