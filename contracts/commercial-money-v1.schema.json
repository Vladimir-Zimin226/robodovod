{
  "$defs": {
    "CommercialScopeV1": {
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "enum": [
            "BARE_EQUIPMENT",
            "CONFIGURED_EQUIPMENT",
            "TURNKEY_SOLUTION",
            "SERVICE_TARIFF",
            "SCENARIO_BUDGET"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "position_id": {
          "minLength": 1,
          "title": "Position Id",
          "type": "string"
        },
        "procurement_option_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Procurement Option Id"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "required": [
        "model_id",
        "position_id",
        "boundary"
      ],
      "title": "CommercialScopeV1",
      "type": "object"
    },
    "CommercialSourceV1": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "USER",
            "FILE",
            "ORGANIZER_DATASET",
            "VENDOR_QUOTE",
            "ASSUMPTION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed On"
        },
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "kind",
        "source_id"
      ],
      "title": "CommercialSourceV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "currency": {
      "enum": [
        "RUB",
        "USD",
        "EUR",
        "UNKNOWN"
      ],
      "title": "Currency",
      "type": "string"
    },
    "raw_amount": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "title": "Raw Amount",
      "type": "string"
    },
    "schema_version": {
      "const": "commercial-money-v1",
      "default": "commercial-money-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/CommercialScopeV1"
    },
    "source": {
      "$ref": "#/$defs/CommercialSourceV1"
    },
    "tax_basis": {
      "enum": [
        "CASH_GROSS_RUB",
        "NET_RUB",
        "UNKNOWN"
      ],
      "title": "Tax Basis",
      "type": "string"
    },
    "vat_rate": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vat Rate"
    },
    "zero_semantics": {
      "anyOf": [
        {
          "enum": [
            "EXCLUDED_BY_SCENARIO",
            "ZERO_PRICE_CONFIRMED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zero Semantics"
    }
  },
  "required": [
    "raw_amount",
    "currency",
    "tax_basis",
    "source",
    "scope"
  ],
  "title": "CommercialMoneyV1",
  "type": "object"
}
