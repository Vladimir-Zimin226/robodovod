{
  "$defs": {
    "MetricDeltaV1": {
      "additionalProperties": false,
      "properties": {
        "baseline_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Value"
        },
        "delta_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta Value"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "NOT_REACHED",
            "BLOCKED"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "RUB",
            "YEAR"
          ],
          "title": "Unit",
          "type": "string"
        },
        "variant_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Variant Value"
        }
      },
      "required": [
        "status",
        "baseline_value",
        "variant_value",
        "delta_value",
        "unit"
      ],
      "title": "MetricDeltaV1",
      "type": "object"
    },
    "SensitivityOverrideV1": {
      "additionalProperties": false,
      "properties": {
        "base_value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Base Value",
          "type": "string"
        },
        "delta_fraction": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Delta Fraction",
          "type": "string"
        },
        "direction": {
          "enum": [
            "LOWER",
            "UPPER"
          ],
          "title": "Direction",
          "type": "string"
        },
        "parameter_id": {
          "enum": [
            "EQUIPMENT_PRICE",
            "OPERATION_VOLUME",
            "ROLE_SALARY"
          ],
          "title": "Parameter Id",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "const": "USER",
          "default": "USER",
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "variant_value": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Variant Value",
          "type": "string"
        }
      },
      "required": [
        "parameter_id",
        "direction",
        "delta_fraction",
        "scope_id",
        "base_value",
        "variant_value",
        "unit",
        "provenance_ref"
      ],
      "title": "SensitivityOverrideV1",
      "type": "object"
    },
    "SensitivityReplayV1": {
      "additionalProperties": false,
      "properties": {
        "baseline_allocation_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Baseline Allocation Result Digest",
          "type": "string"
        },
        "canonical_input_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Canonical Input Digest",
          "type": "string"
        },
        "ranking_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Ranking Result Digest",
          "type": "string"
        },
        "trace_content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Trace Content Digest",
          "type": "string"
        },
        "variant_allocation_result_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Variant Allocation Result Digests",
          "type": "array"
        }
      },
      "required": [
        "canonical_input_digest",
        "baseline_allocation_result_digest",
        "ranking_result_digest",
        "variant_allocation_result_digests",
        "trace_content_digest"
      ],
      "title": "SensitivityReplayV1",
      "type": "object"
    },
    "SensitivityTraceNodeV1": {
      "additionalProperties": false,
      "properties": {
        "input_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "node_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Node Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "BIND_BASELINE",
            "APPLY_OVERRIDE",
            "RERUN_ENGINE",
            "COMPARE_DELTA",
            "BLOCK_VARIANT"
          ],
          "title": "Operation",
          "type": "string"
        },
        "output_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Output Ref",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "node_id",
        "operation",
        "input_refs",
        "output_ref",
        "value",
        "unit"
      ],
      "title": "SensitivityTraceNodeV1",
      "type": "object"
    },
    "SensitivityVariantResultV1": {
      "additionalProperties": false,
      "properties": {
        "allocation_result_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allocation Result Digest"
        },
        "allocation_trace_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Allocation Trace Digest"
        },
        "capacity_fleet_base": {
          "minimum": 0,
          "title": "Capacity Fleet Base",
          "type": "integer"
        },
        "capacity_fleet_delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capacity Fleet Delta"
        },
        "capacity_fleet_variant": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capacity Fleet Variant"
        },
        "derived_run_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Derived Run Id",
          "type": "string"
        },
        "discounted_payback": {
          "$ref": "#/$defs/MetricDeltaV1"
        },
        "issues": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "npv_project": {
          "$ref": "#/$defs/MetricDeltaV1"
        },
        "override": {
          "$ref": "#/$defs/SensitivityOverrideV1"
        },
        "project_capex": {
          "$ref": "#/$defs/MetricDeltaV1"
        },
        "simple_payback": {
          "$ref": "#/$defs/MetricDeltaV1"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "BLOCKED"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_reasons": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Step Reasons",
          "type": "array"
        },
        "variant_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "derived_run_id",
        "status",
        "override",
        "allocation_result_digest",
        "allocation_trace_digest",
        "capacity_fleet_base",
        "capacity_fleet_variant",
        "capacity_fleet_delta",
        "project_capex",
        "npv_project",
        "simple_payback",
        "discounted_payback",
        "step_reasons",
        "issues"
      ],
      "title": "SensitivityVariantResultV1",
      "type": "object"
    },
    "SensitivityVersionsV1": {
      "additionalProperties": false,
      "properties": {
        "allocation_engine_version": {
          "const": "multiprocess-allocation-v1",
          "default": "multiprocess-allocation-v1",
          "title": "Allocation Engine Version",
          "type": "string"
        },
        "calculation_policy_version": {
          "const": "hackathon-calculation-policy-v1",
          "default": "hackathon-calculation-policy-v1",
          "title": "Calculation Policy Version",
          "type": "string"
        },
        "engine_version": {
          "const": "economics-sensitivity-v1",
          "default": "economics-sensitivity-v1",
          "title": "Engine Version",
          "type": "string"
        },
        "precision_policy_version": {
          "const": "decimal-context-28-half-even-v1",
          "default": "decimal-context-28-half-even-v1",
          "title": "Precision Policy Version",
          "type": "string"
        },
        "ranking_result_version": {
          "const": "ranking-result-v2",
          "default": "ranking-result-v2",
          "title": "Ranking Result Version",
          "type": "string"
        },
        "request_version": {
          "const": "sensitivity-request-v1",
          "default": "sensitivity-request-v1",
          "title": "Request Version",
          "type": "string"
        },
        "result_version": {
          "const": "sensitivity-result-v1",
          "default": "sensitivity-result-v1",
          "title": "Result Version",
          "type": "string"
        }
      },
      "title": "SensitivityVersionsV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_allocation_result_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Baseline Allocation Result Digest",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "parent_run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Parent Run Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "ranking_result_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Ranking Result Digest",
      "type": "string"
    },
    "replay": {
      "$ref": "#/$defs/SensitivityReplayV1"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "sensitivity-result-v1",
      "default": "sensitivity-result-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_candidate_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Selected Candidate Id",
      "type": "string"
    },
    "selected_configuration_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Selected Configuration Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/SensitivityTraceNodeV1"
      },
      "title": "Trace",
      "type": "array"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/SensitivityVariantResultV1"
      },
      "title": "Variants",
      "type": "array"
    },
    "versions": {
      "$ref": "#/$defs/SensitivityVersionsV1"
    }
  },
  "required": [
    "run_id",
    "parent_run_id",
    "project_id",
    "tenant_id",
    "object_id",
    "baseline_allocation_result_digest",
    "ranking_result_digest",
    "selected_candidate_id",
    "selected_configuration_id",
    "variants",
    "trace",
    "versions",
    "replay"
  ],
  "title": "SensitivityResultV1",
  "type": "object"
}
