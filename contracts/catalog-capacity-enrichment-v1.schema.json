          "minLength": 1,
          "title": "Accessed At",
          "type": "string"
        },
        "publication_or_update_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publication Or Update Date"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "raw_value": {
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "source_locator": {
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "source_title": {
          "minLength": 1,
          "title": "Source Title",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
