    "RaasTermsV1": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "const": "RAAS",
          "default": "RAAS",
          "title": "Acquisition",
          "type": "string"
        },
        "billing_basis": {
          "enum": [
            "PER_ROBOT_MONTH",
            "PER_SITE_MONTH"
          ],
          "title": "Billing Basis",
          "type": "string"
        },
        "buyout": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommercialMoneyV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
