          "type": "integer"
        },
        "cost_lines": {
          "items": {
            "$ref": "#/$defs/CommercialCostLineV1"
          },
          "title": "Cost Lines",
          "type": "array"
        },
        "deployment_mode": {
          "enum": [
            "ALL_FLEET",
            "PHASED"
          ],
          "title": "Deployment Mode",
          "type": "string"
        },
        "renewal": {
          "enum": [
            "SAME_TERMS_TO_HORIZON",
            "MANUAL_REVIEW"
          ],
          "title": "Renewal",
          "type": "string"
        },
        "responsibilities": {
          "items": {
            "$ref": "#/$defs/ServiceResponsibilityV1"
          },
          "title": "Responsibilities",
          "type": "array"
        },
        "schema_version": {
          "const": "raas-terms-v1",
          "default": "raas-terms-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tariff_basis": {
          "discriminator": {
            "mapping": {
              "FIXED_TOTAL": "#/$defs/FixedTotalBasisV1",
              "PERCENT_BASE": "#/$defs/PercentBaseBasisV1",
              "PER_ROBOT": "#/$defs/PerRobotBasisV1"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedTotalBasisV1"
            },
            {
              "$ref": "#/$defs/PerRobotBasisV1"
