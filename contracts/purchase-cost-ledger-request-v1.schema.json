          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Capacity Result Digest",
          "type": "string"
        },
        "days_per_year": {
          "$ref": "#/$defs/SourcedValueV1"
        },
        "operating_hours_per_day": {
          "$ref": "#/$defs/SourcedValueV1"
        }
      },
      "required": [
        "operating_hours_per_day",
        "days_per_year",
        "availability",
        "capacity_result_digest"
      ],
      "title": "OperatingBasisV1",
      "type": "object"
    },
    "PerRobotBasisV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "PER_ROBOT",
          "default": "PER_ROBOT",
          "title": "Kind",
          "type": "string"
        },
        "money": {
          "$ref": "#/$defs/CommercialMoneyV1"
        }
      },
      "required": [
        "money"
      ],
      "title": "PerRobotBasisV1",
      "type": "object"
    },
    "PercentBaseBasisV1": {
      "additionalProperties": false,
      "properties": {
        "base_line_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Base Line Id",
          "type": "string"
        },
        "kind": {
          "const": "PERCENT_BASE",
          "default": "PERCENT_BASE",
          "title": "Kind",
          "type": "string"
        },
        "rate": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Rate",
          "type": "string"
        }
      },
      "required": [
        "rate",
        "base_line_id"
      ],
      "title": "PercentBaseBasisV1",
      "type": "object"
    },
    "PowerEnergyPathV1": {
      "additionalProperties": false,
      "properties": {
        "average_power_w": {
          "$ref": "#/$defs/SourcedValueV1"
        },
        "kind": {
          "const": "POWER",
          "default": "POWER",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "average_power_w"
      ],
      "title": "PowerEnergyPathV1",
      "type": "object"
    },
    "ProcurementGroundV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "APPLIED",
            "IGNORED_STALE",
            "IGNORED_SCOPE",
            "INFORMATIONAL"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "code",
        "outcome",
        "message"
      ],
      "title": "ProcurementGroundV1",
      "type": "object"
    },
    "ProcurementReportV1": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "enum": [
            "PURCHASE",
            "RAAS"
          ],
          "title": "Acquisition",
          "type": "string"
        },
        "blockers": {
          "items": {
            "enum": [
              "COMMERCIAL_PRICE_MISSING",
              "COMMERCIAL_SCOPE_MISMATCH",
              "VENDOR_QUOTE_EVIDENCE_MISMATCH",
              "CURRENCY_REQUIRED",
              "UNVERIFIED_VENDOR_QUOTE",
              "ORGANIZER_PRICE_MISMATCH",
              "COMMERCIAL_LINE_SCOPE_MISMATCH",
              "UNSUPPORTED_CURRENCY",
              "EXPLICIT_VAT_RATE_REQUIRED",
              "TAX_BASIS_REQUIRED",
              "AMBIGUOUS_COMMERCIAL_SOURCE",
              "ZERO_SEMANTICS_REQUIRED",
              "PROCUREMENT_ASSERTION_SCOPE_MISMATCH",
              "UNVERIFIED_PROCUREMENT_ASSERTION",
              "QUOTE_VALIDITY_UNKNOWN",
              "STALE_QUOTE",
              "STALE_PROCUREMENT_ASSERTION",
              "SERVICE_RESPONSIBILITIES_UNKNOWN"
            ],
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "commercial_policy_version": {
          "const": "hackathon-commercial-policy-v1",
          "default": "hackathon-commercial-policy-v1",
          "title": "Commercial Policy Version",
          "type": "string"
        },
        "evaluation_date": {
          "format": "date",
          "title": "Evaluation Date",
          "type": "string"
        },
        "grounds": {
          "items": {
            "$ref": "#/$defs/ProcurementGroundV1"
          },
          "title": "Grounds",
          "type": "array"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "money": {
          "$ref": "#/$defs/CommercialResolutionV1"
        },
        "position_id": {
          "minLength": 1,
          "title": "Position Id",
          "type": "string"
        },
        "procurement_ready": {
          "title": "Procurement Ready",
          "type": "boolean"
        },
        "procurement_status": {
          "enum": [
            "DISCONTINUED",
            "SUPPLY_RISK",
            "CONFIRMED_AVAILABLE",
            "QUOTE_REQUIRED",
            "LIKELY_AVAILABLE",
            "UNVERIFIED"
          ],
          "title": "Procurement Status",
          "type": "string"
        },
        "responsibilities": {
          "items": {
            "$ref": "#/$defs/ServiceResponsibilityV1"
          },
          "title": "Responsibilities",
          "type": "array"
        },
        "schema_version": {
          "const": "procurement-report-v1",
          "default": "procurement-report-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "supply_risk": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ],
          "title": "Supply Risk",
          "type": "string"
        },
        "terms": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "PURCHASE": "#/$defs/PurchaseTermsV1",
                  "RAAS": "#/$defs/RaasTermsV1"
                },
                "propertyName": "acquisition"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PurchaseTermsV1"
                },
                {
                  "$ref": "#/$defs/RaasTermsV1"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms"
        },
        "warnings": {
          "items": {
            "enum": [
              "COMMERCIAL_PRICE_MISSING",
              "COMMERCIAL_SCOPE_MISMATCH",
              "VENDOR_QUOTE_EVIDENCE_MISMATCH",
              "CURRENCY_REQUIRED",
              "UNVERIFIED_VENDOR_QUOTE",
              "ORGANIZER_PRICE_MISMATCH",
              "COMMERCIAL_LINE_SCOPE_MISMATCH",
              "UNSUPPORTED_CURRENCY",
              "EXPLICIT_VAT_RATE_REQUIRED",
              "TAX_BASIS_REQUIRED",
              "AMBIGUOUS_COMMERCIAL_SOURCE",
              "ZERO_SEMANTICS_REQUIRED",
              "PROCUREMENT_ASSERTION_SCOPE_MISMATCH",
              "UNVERIFIED_PROCUREMENT_ASSERTION",
              "QUOTE_VALIDITY_UNKNOWN",
              "STALE_QUOTE",
              "STALE_PROCUREMENT_ASSERTION",
              "SERVICE_RESPONSIBILITIES_UNKNOWN"
            ],
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "position_id",
        "acquisition",
        "evaluation_date",
        "procurement_status",
        "procurement_ready",
        "supply_risk",
        "money"
      ],
      "title": "ProcurementReportV1",
      "type": "object"
    },
    "PurchaseTermsV1": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "const": "PURCHASE",
          "default": "PURCHASE",
          "title": "Acquisition",
          "type": "string"
        },
        "cost_lines": {
          "items": {
            "$ref": "#/$defs/CommercialCostLineV1"
          },
          "title": "Cost Lines",
          "type": "array"
        },
        "primary_price": {
          "$ref": "#/$defs/CommercialMoneyV1"
        },
        "responsibilities": {
