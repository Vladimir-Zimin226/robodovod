{
  "$defs": {
    "BatteryEnergyPathV1": {
      "additionalProperties": false,
      "properties": {
        "autonomy_hours": {
          "$ref": "#/$defs/SourcedValueV1"
        },
        "battery_kwh": {
          "$ref": "#/$defs/SourcedValueV1"
        },
        "kind": {
          "const": "BATTERY_AUTONOMY",
          "default": "BATTERY_AUTONOMY",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "battery_kwh",
        "autonomy_hours"
      ],
      "title": "BatteryEnergyPathV1",
      "type": "object"
    },
    "CommercialCostLineV1": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "discriminator": {
            "mapping": {
              "FIXED_TOTAL": "#/$defs/FixedTotalBasisV1",
              "PERCENT_BASE": "#/$defs/PercentBaseBasisV1",
              "PER_ROBOT": "#/$defs/PerRobotBasisV1"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedTotalBasisV1"
            },
            {
              "$ref": "#/$defs/PerRobotBasisV1"
            },
            {
              "$ref": "#/$defs/PercentBaseBasisV1"
            }
          ],
          "title": "Basis"
        },
        "category": {
          "enum": [
            "ROBOT",
            "CHARGER",
            "INTEGRATION",
            "INFRASTRUCTURE",
            "DELIVERY",
            "COMMISSIONING",
            "TRAINING",
            "SERVICE",
            "SOFTWARE",
            "SPARES",
            "RECURRING_SUPPLIES",
            "OTHER"
          ],
          "title": "Category",
          "type": "string"
        },
        "excluded_by_scenario": {
          "default": false,
          "title": "Excluded By Scenario",
          "type": "boolean"
        },
        "included_in": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Included In",
          "type": "array"
        },
        "line_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Line Id",
          "type": "string"
        },
        "timing": {
          "enum": [
            "CAPITAL_ONCE",
            "ANNUAL",
            "MONTHLY"
          ],
          "title": "Timing",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "category",
        "timing",
        "basis"
      ],
      "title": "CommercialCostLineV1",
      "type": "object"
    },
    "CommercialMoneyV1": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "enum": [
            "RUB",
            "USD",
            "EUR",
            "UNKNOWN"
          ],
          "title": "Currency",
          "type": "string"
        },
        "raw_amount": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Raw Amount",
          "type": "string"
        },
        "schema_version": {
          "const": "commercial-money-v1",
          "default": "commercial-money-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/CommercialScopeV1"
        },
        "source": {
          "$ref": "#/$defs/CommercialSourceV1"
        },
        "tax_basis": {
          "enum": [
            "CASH_GROSS_RUB",
            "NET_RUB",
            "UNKNOWN"
          ],
          "title": "Tax Basis",
          "type": "string"
        },
        "vat_rate": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vat Rate"
        },
        "zero_semantics": {
          "anyOf": [
            {
              "enum": [
                "EXCLUDED_BY_SCENARIO",
                "ZERO_PRICE_CONFIRMED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zero Semantics"
        }
      },
      "required": [
        "raw_amount",
        "currency",
        "tax_basis",
        "source",
        "scope"
      ],
      "title": "CommercialMoneyV1",
      "type": "object"
    },
    "CommercialResolutionV1": {
      "additionalProperties": false,
      "properties": {
        "cash_gross_rub": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cash Gross Rub"
        },
        "operation": {
          "enum": [
            "IDENTITY",
            "APPLY_EXPLICIT_VAT",
            "NONE"
          ],
          "title": "Operation",
          "type": "string"
        },
        "provenance_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Provenance Refs",
          "type": "array"
        },
        "raw_money": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommercialMoneyV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "RESOLVED",
            "BLOCKED",
            "NOT_PROVIDED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "raw_money",
        "cash_gross_rub",
        "operation"
      ],
      "title": "CommercialResolutionV1",
      "type": "object"
    },
    "CommercialScopeV1": {
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "enum": [
            "BARE_EQUIPMENT",
            "CONFIGURED_EQUIPMENT",
            "TURNKEY_SOLUTION",
            "SERVICE_TARIFF",
            "SCENARIO_BUDGET"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "position_id": {
          "minLength": 1,
          "title": "Position Id",
          "type": "string"
        },
        "procurement_option_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Procurement Option Id"
        },
        "region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "required": [
        "model_id",
        "position_id",
        "boundary"
      ],
      "title": "CommercialScopeV1",
      "type": "object"
    },
    "CommercialSourceV1": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "USER",
            "FILE",
            "ORGANIZER_DATASET",
            "VENDOR_QUOTE",
            "ASSUMPTION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed On"
        },
        "source_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "kind",
        "source_id"
      ],
      "title": "CommercialSourceV1",
      "type": "object"
    },
    "FixedTotalBasisV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "FIXED_TOTAL",
          "default": "FIXED_TOTAL",
          "title": "Kind",
          "type": "string"
        },
        "money": {
          "$ref": "#/$defs/CommercialMoneyV1"
        }
      },
      "required": [
        "money"
      ],
      "title": "FixedTotalBasisV1",
      "type": "object"
    },
    "IncludedBatteryLifecycleV1": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "INCLUDED_IN_SERVICE",
          "default": "INCLUDED_IN_SERVICE",
          "title": "Mode",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        }
      },
      "required": [
        "provenance_ref"
      ],
      "title": "IncludedBatteryLifecycleV1",
      "type": "object"
    },
    "InitialBatteryPolicyV1": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "INCLUDED_IN_ROBOT_PRICE",
            "SEPARATE_CAPEX"
          ],
          "title": "Mode",
          "type": "string"
        },
        "provenance_ref": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
          "title": "Provenance Ref",
          "type": "string"
        },
        "separate_unit_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourcedValueV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "provenance_ref"
      ],
      "title": "InitialBatteryPolicyV1",
      "type": "object"
    },
    "LabourOpexProjectionV1": {
      "additionalProperties": false,
      "properties": {
        "additional_control_required": {
          "minimum": 0,
          "title": "Additional Control Required",
          "type": "integer"
        },
        "control_annual_direct": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Annual Direct"
        },
        "source_result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Result Digest",
          "type": "string"
        },
        "technician_annual_direct": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technician Annual Direct"
        },
        "technicians_required": {
          "minimum": 0,
          "title": "Technicians Required",
          "type": "integer"
        }
      },
      "required": [
        "technicians_required",
        "additional_control_required",
        "source_result_digest"
      ],
      "title": "LabourOpexProjectionV1",
      "type": "object"
    },
    "OperatingBasisV1": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/SourcedValueV1"
        },
