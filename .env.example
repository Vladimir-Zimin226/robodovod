# Copy this file to .env and replace every <...> placeholder.
# The application role is deliberately different from the PostgreSQL bootstrap
# superuser. URL-encode special characters in DATABASE_URL passwords.
POSTGRES_DB=<database-name>
POSTGRES_ADMIN_USER=<bootstrap-superuser-name>
POSTGRES_ADMIN_PASSWORD=<bootstrap-superuser-password>
APP_DB_USER=<non-superuser-application-role>
APP_DB_PASSWORD=<application-role-password>
POSTGRES_PORT=<host-port>
DATABASE_URL=postgresql+psycopg://<application-role>:<url-encoded-password>@db:5432/<database-name>

# One-shot first administrator. Keep real values only in ignored .env or a
# deployment secret, then run the admin-bootstrap tools service explicitly.
BOOTSTRAP_ADMIN_EMAIL=<first-admin-email>
BOOTSTRAP_ADMIN_PASSWORD=<strong-first-admin-password>
BOOTSTRAP_ADMIN_NAME=<optional-first-admin-name>

# Local HTTP development uses false; HTTPS deployments must use true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DELETION_TOMBSTONE_DAYS=30

# Safe default/instant rollback is legacy. Set to activated only after a
# successful `catalog-activation activate --slot runtime`; an unsafe or absent
# runtime activation fails closed instead of borrowing legacy facts.
CATALOG_RUNTIME_SOURCE=legacy

# Optional YandexGPT credentials. Leave placeholders empty in a real local .env
# when the deterministic offline fallback is desired.
YC_FOLDER_ID=<optional-folder-id>
YC_API_KEY=<optional-api-key>
