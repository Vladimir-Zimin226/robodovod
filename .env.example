# Copy this file to .env and replace every <...> placeholder.
# The application role is deliberately different from the PostgreSQL bootstrap
# superuser. URL-encode special characters in DATABASE_URL passwords.
POSTGRES_DB=<database-name>
POSTGRES_ADMIN_USER=<bootstrap-superuser-name>
POSTGRES_ADMIN_PASSWORD=<bootstrap-superuser-password>
APP_DB_USER=<non-superuser-application-role>
APP_DB_PASSWORD=<application-role-password>
POSTGRES_PORT=<host-port>
DATABASE_URL=postgresql+psycopg://<application-role>:<url-encoded-password>@db:5432/<database-name>

# Optional YandexGPT credentials. Leave placeholders empty in a real local .env
# when the deterministic offline fallback is desired.
YC_FOLDER_ID=<optional-folder-id>
YC_API_KEY=<optional-api-key>
